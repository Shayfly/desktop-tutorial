OMNI_ENV=production
OMNI_SECRET_KEY=CHANGE_ME_WITH_64_RANDOM_CHARS
OMNI_DATABASE_URL=postgresql://omni:CHANGE_ME@postgres:5432/omni
OMNI_REDIS_URL=redis://redis:6379/0

OMNI_S3_ENDPOINT=http://minio:9000
OMNI_S3_BUCKET=omni-artifacts
OMNI_S3_ACCESS_KEY=CHANGE_ME
OMNI_S3_SECRET_KEY=CHANGE_ME
OMNI_S3_REGION=us-east-1

OMNI_SANDBOX_IMAGE=omni-sandbox:latest
OMNI_SANDBOX_TIMEOUT_SECONDS=180
OMNI_SANDBOX_MEMORY=1024m
OMNI_SANDBOX_CPUS=1.5
OMNI_SANDBOX_PIDS=256

OMNI_SESSION_SECURE=true
OMNI_SESSION_SAMESITE=lax
OMNI_ALLOWED_ORIGINS=https://app.example.com

OMNI_DB_POOL_MIN_SIZE=2
OMNI_DB_POOL_MAX_SIZE=10
OMNI_DB_POOL_TIMEOUT_SECONDS=10
OMNI_DB_CONNECT_TIMEOUT_SECONDS=5
OMNI_REDIS_SOCKET_TIMEOUT_SECONDS=5
OMNI_REDIS_CONNECT_TIMEOUT_SECONDS=5

# V22 autonomous model runtime
OMNI_LOCAL_MODEL_NAME=omni-local
OMNI_LOCAL_MODEL_URL=http://127.0.0.1:8001/v1
OMNI_LOCAL_MODEL_ID=local-coder
OMNI_LOCAL_MODEL_TIMEOUT=120
OMNI_ZERO_COST_MODE=1
OMNI_ALLOW_EXTERNAL_FALLBACK=0
OMNI_EXTERNAL_BUDGET_USD=0
OMNI_EXTERNAL_CALLS_PER_BUILD=0
# OMNI_EXTERNAL_MODELS_JSON=[]

# V23 live autonomous build switch (off by default)
OMNI_ENABLE_LIVE_BUILD=0
OMNI_MAX_REPAIR_ROUNDS=3
# Conservative budget estimate used before each external fallback call.
OMNI_EXTERNAL_MAX_ESTIMATED_COST_USD_PER_CALL=0.25

# V24 international runtime
OMNI_MIN_QUALITY_SCORE=80
OMNI_SANDBOX_RUNNER_URL=
OMNI_SANDBOX_SHARED_SECRET=CHANGE_ME_WITH_64_RANDOM_CHARS
OMNI_LOCAL_MODEL_HF_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct
# For production, set HTTPS-only origins, e.g. https://app.example.com
# OMNI_ALLOWED_ORIGINS=https://app.example.com

# V28 148AI brand / commercial controls
OMNI_PUBLIC_BRAND=148AI
OMNI_PUBLIC_DOMAIN=148ailabs.com
OMNI_CREATOR_PERSISTENCE=memory
# Set OMNI_CREATOR_PERSISTENCE=postgres after migrations 011/012 and live DB verification.
OMNI_BILLING_ADMIN_KEY=SET_IN_SECRET_MANAGER
OMNI_PRICE_BASIC_USD=12
OMNI_PRICE_PRO_USD=39
OMNI_PRICE_BUSINESS_USD=99
OMNI_PROVIDER_CAP_BASIC_USD=2.50
OMNI_PROVIDER_CAP_PRO_USD=10
OMNI_PROVIDER_CAP_BUSINESS_USD=25

# Paid billing provider (not considered live until checkout + signed webhook tests pass)
STRIPE_SECRET_KEY=SET_IN_SECRET_MANAGER
STRIPE_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER

# Email
RESEND_API_KEY=SET_IN_SECRET_MANAGER

# GPU / media
RUNPOD_API_KEY=SET_IN_SECRET_MANAGER
OMNI_MEDIA_BASE_URL=

# Mobile signing (keep in secret manager/CI, never commit real values)
ANDROID_KEYSTORE=
ANDROID_KEYSTORE_PASSWORD=SET_IN_SECRET_MANAGER
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=SET_IN_SECRET_MANAGER
APPLE_TEAM_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=SET_IN_SECRET_MANAGER
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=SET_IN_SECRET_MANAGER
OMNI_BRAND_TRADEMARK_CLEARED=0
OMNI_BRAND_TRADEMARK_FILED=0
OMNI_BRAND_DOMAIN_OWNED=0
OMNI_BRAND_DNS_TLS_READY=0
OMNI_PRICE_BASIC_ANNUAL_USD=120
OMNI_PRICE_PRO_ANNUAL_USD=390
OMNI_PRICE_BUSINESS_ANNUAL_USD=990
OMNI_PUBLIC_BASE_URL=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
