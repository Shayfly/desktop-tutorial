# 148AI environment template — placeholders only. Never commit real credentials.
# Production values belong in the deployment secret manager (for example Vercel
# Environment Variables / GitHub Actions secrets / Vault), not in this file.

# Core runtime
OMNI_ENV=production
OMNI_SECRET_KEY=CHANGE_ME_WITH_64_RANDOM_CHARS
OMNI_ALLOWED_ORIGINS=https://app.example.com
OMNI_PUBLIC_BASE_URL=

# PostgreSQL / Redis
POSTGRES_PASSWORD=CHANGE_ME
OMNI_DATABASE_URL=postgresql://omni:CHANGE_ME@postgres:5432/omni
OMNI_REDIS_URL=redis://redis:6379/0
OMNI_DB_POOL_MIN_SIZE=2
OMNI_DB_POOL_MAX_SIZE=10
OMNI_DB_POOL_TIMEOUT_SECONDS=10
OMNI_DB_CONNECT_TIMEOUT_SECONDS=5
OMNI_REDIS_SOCKET_TIMEOUT_SECONDS=5
OMNI_REDIS_CONNECT_TIMEOUT_SECONDS=5

# S3-compatible artifact storage
OMNI_S3_ENDPOINT=http://minio:9000
OMNI_S3_BUCKET=omni-artifacts
OMNI_S3_ACCESS_KEY=CHANGE_ME
OMNI_S3_SECRET_KEY=CHANGE_ME
OMNI_S3_REGION=us-east-1

# Sandbox runtime
OMNI_SANDBOX_IMAGE=omni-sandbox:latest
OMNI_SANDBOX_TIMEOUT_SECONDS=180
OMNI_SANDBOX_MEMORY=1024m
OMNI_SANDBOX_CPUS=1.5
OMNI_SANDBOX_PIDS=256
OMNI_SANDBOX_RUNNER_URL=
OMNI_SANDBOX_SHARED_SECRET=CHANGE_ME_WITH_64_RANDOM_CHARS

# Browser/session security
OMNI_SESSION_SECURE=true
OMNI_SESSION_SAMESITE=lax

# V22 autonomous model runtime
OMNI_LOCAL_MODEL_NAME=omni-local
OMNI_LOCAL_MODEL_URL=http://127.0.0.1:8001/v1
OMNI_LOCAL_MODEL_ID=local-coder
OMNI_LOCAL_MODEL_TIMEOUT=120
OMNI_ZERO_COST_MODE=1
OMNI_ALLOW_EXTERNAL_FALLBACK=0
OMNI_EXTERNAL_BUDGET_USD=0
OMNI_EXTERNAL_CALLS_PER_BUILD=0
# OMNI_EXTERNAL_MODELS_JSON=[]

# V23 live autonomous build switch (off by default)
OMNI_ENABLE_LIVE_BUILD=0
OMNI_MAX_REPAIR_ROUNDS=3
OMNI_EXTERNAL_MAX_ESTIMATED_COST_USD_PER_CALL=0.25

# V24 international runtime
OMNI_MIN_QUALITY_SCORE=80
OMNI_LOCAL_MODEL_HF_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Intake (conversation) model budgets, USD. Fail closed: any of them missing or 0 = deterministic intake, $0.
# OMNI_INTAKE_CALL_BUDGET_USD is a PRE-CHECK only (omni_prod/intake/mode.py): a model turn is offered while
# project spent + this value <= the project cap and 24 h spent + this value <= the daily cap. It does NOT cap
# the amount actually reserved per message -- that is the price quote (omni_prod/intake/budget.py quote()),
# which can be larger (0.00555 for one Venice message on 2026-10-28). The reservation itself enforces both caps.
OMNI_INTAKE_MODEL=0
OMNI_INTAKE_MODEL_BUDGET_USD=0
OMNI_INTAKE_DAILY_BUDGET_USD=0
OMNI_INTAKE_CALL_BUDGET_USD=0.005

# V28 148AI brand / commercial controls
OMNI_PUBLIC_BRAND=148AI
OMNI_PUBLIC_DOMAIN=148ailabs.com
OMNI_CREATOR_PERSISTENCE=memory
# Set OMNI_CREATOR_PERSISTENCE=postgres only after migrations 011/012 and live DB verification.
OMNI_BILLING_ADMIN_KEY=SET_IN_SECRET_MANAGER
# Plan prices and paid-provider caps (USD). These equal the defaults in omni_prod/pricing.py (CEO 2026-10-19:
# Free 0 / Amateur 29 / Pro 99 / Studio 299; annual = 2 months free). A value set here OVERRIDES the default,
# so keep them equal unless the change is deliberate. tests/test_env_example_pricing.py enforces this.
# The pre-rename names (OMNI_PRICE_BASIC_*, OMNI_PRICE_BUSINESS_*, OMNI_PROVIDER_CAP_BASIC/BUSINESS_*) are still read.
OMNI_PRICE_AMATEUR_USD=29
OMNI_PRICE_PRO_USD=99
OMNI_PRICE_STUDIO_USD=299
OMNI_PRICE_AMATEUR_ANNUAL_USD=290
OMNI_PRICE_PRO_ANNUAL_USD=990
OMNI_PRICE_STUDIO_ANNUAL_USD=2990
OMNI_PROVIDER_CAP_FREE_USD=1.05
OMNI_PROVIDER_CAP_AMATEUR_USD=2.50
OMNI_PROVIDER_CAP_PRO_USD=10
OMNI_PROVIDER_CAP_STUDIO_USD=25

# Paid billing provider — secret-manager values only
STRIPE_SECRET_KEY=SET_IN_SECRET_MANAGER
STRIPE_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email
RESEND_API_KEY=SET_IN_SECRET_MANAGER

# GPU / media
REPLICATE_API_TOKEN=
# A saved token selects Replicate FLUX.1 schnell unless another image provider
# is explicitly configured. No request is made merely by configuring the key.
# Published price: https://replicate.com/pricing, checked 2026-10-06 ($0.003/image).
# Custom models need explicit OMNI_IMAGE_PROVIDER_* pricing and licence settings.
RUNPOD_API_KEY=SET_IN_SECRET_MANAGER
# Venice (agent.venice model provider; private models only). Name is exact, with the digit; no fallback name.
VENICE_API_KEY1=SET_IN_SECRET_MANAGER
OMNI_MEDIA_BASE_URL=

# Mobile signing — keep in secret-managed CI, never commit real values
ANDROID_KEYSTORE=
ANDROID_KEYSTORE_PASSWORD=SET_IN_SECRET_MANAGER
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=SET_IN_SECRET_MANAGER
APPLE_TEAM_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=SET_IN_SECRET_MANAGER
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=SET_IN_SECRET_MANAGER

# Brand readiness flags
OMNI_BRAND_TRADEMARK_CLEARED=0
OMNI_BRAND_TRADEMARK_FILED=0
OMNI_BRAND_DOMAIN_OWNED=0
OMNI_BRAND_DNS_TLS_READY=0

# Generated-app secrets (separate from creator/control-plane infrastructure)
# Select infisical explicitly; Vault remains the default for existing deployments.
OMNI_GENAPP_SECRET_STORE_PROVIDER=vault
OMNI_INFISICAL_BASE_URL=
OMNI_INFISICAL_PROJECT_ID=
OMNI_INFISICAL_ENVIRONMENT=dev
OMNI_INFISICAL_CLIENT_ID=
OMNI_INFISICAL_CLIENT_SECRET=
# Vault alternative:
OMNI_GENAPP_SECRET_STORE_URL=
OMNI_GENAPP_SECRET_STORE_TOKEN_ENV=OMNI_GENAPP_VAULT_TOKEN
OMNI_GENAPP_VAULT_TOKEN=
OMNI_GENAPP_SECRET_MOUNT=secret

# Generated-app object storage (parent keys restricted to generated bucket only).
# Keep aws_sts for existing AWS/MinIO deployments; explicitly opt into cloudflare_r2.
OMNI_GENAPP_S3_PROVIDER=aws_sts
OMNI_GENAPP_S3_ENDPOINT=
OMNI_GENAPP_S3_BUCKET=
OMNI_GENAPP_S3_REGION=auto
OMNI_GENAPP_S3_ACCESS_KEY=
OMNI_GENAPP_S3_SECRET_KEY=
OMNI_GENAPP_S3_ACCESS_KEY_REF=env:OMNI_GENAPP_S3_ACCESS_KEY
OMNI_GENAPP_S3_SECRET_KEY_REF=env:OMNI_GENAPP_S3_SECRET_KEY
OMNI_GENAPP_S3_CREDENTIAL_TTL_SECONDS=3600
# AWS STS only:
OMNI_GENAPP_S3_ROLE_ARN=
OMNI_GENAPP_S3_STS_ENDPOINT=

# QStash scheduler (server-only). QSTASH_URL opts the generated profile into QStash.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional explicit override: generic_http or qstash.
# OMNI_GENAPP_SCHEDULER_PROVIDER=qstash
