{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://148ai.local/spec/a2_direction.schema.json",
  "title": "A2 (Gemini) skill outputs: search 1.1, verify 1.2, capture 1.3, compose.direction 1.9 -- v0.1",
  "description": "docs/spec/gemini-a2.md. Every A2 output is one of these documents; free text is allowed nowhere except a rejection's evidence numbers. A2 never writes to the customer: there is no field for customer-facing words.",
  "oneOf": [
    {"$ref": "#/$defs/search_run"},
    {"$ref": "#/$defs/verify_result"},
    {"$ref": "#/$defs/capture_result"},
    {"$ref": "#/$defs/direction_set"}
  ],
  "$defs": {
    "id_run": {"type": "string", "pattern": "^a2r_[a-f0-9]{16}$"},
    "id_candidate": {"type": "string", "pattern": "^cand_[a-f0-9]{16}$"},
    "id_card": {"type": "string", "pattern": "^ref_[0-9A-HJKMNP-TV-Z]{26}$", "description": "the reference card id of reference_card.schema.json (#369)"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "https_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]{4,2000}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
    "vertical": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
    "category": {"enum": ["restaurants", "nightlife", "tech", "retail", "beauty", "health", "education",
                          "real_estate", "events", "tourism"]},
    "tier": {"enum": [1, 2, 3], "description": "1: vertical, Hebrew/Israel. 2: vertical, any language. 3: the vertical's category (10 global categories), any language."},
    "reason_code": {"enum": ["not_live", "too_slow", "too_heavy", "unreadable_390", "ltr_text_bound", "robots_disallowed",
                             "capture_missing", "site_builder", "generic_template", "carousel", "first_screen_popup",
                             "placeholder_text", "nav_too_deep", "off_vertical", "duplicate_skeleton",
                             "built_from_reference", "below_threshold", "no_hebrew_font", "internal_contradiction",
                             "too_similar", "estimated_where_observed_required",
                             "content_in_skeleton", "zero_dimension", "judges_disagree"]},

    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "stage", "measured", "threshold", "at"],
      "properties": {
        "reason_code": {"$ref": "#/$defs/reason_code"},
        "stage": {"enum": ["search", "verify", "capture", "extract", "score", "compose"]},
        "measured": {"type": ["number", "boolean", "string"], "maxLength": 80},
        "threshold": {"type": ["number", "boolean", "string"], "maxLength": 80},
        "rule": {"type": "string", "pattern": "^[A-Z][0-9]{1,2}$", "description": "compose only: the contradiction rule id"},
        "duplicate_of": {"$ref": "#/$defs/id_card"},
        "at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"reason_code": {"enum": ["duplicate_skeleton", "too_similar"]}}},
         "then": {"required": ["duplicate_of"]}},
        {"if": {"properties": {"reason_code": {"const": "internal_contradiction"}}},
         "then": {"required": ["rule"]}}
      ]
    },

    "search_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "vertical", "category", "inputs", "queries", "candidates", "coverage", "at"],
      "properties": {
        "kind": {"const": "search_run"},
        "run_id": {"$ref": "#/$defs/id_run"},
        "vertical": {"$ref": "#/$defs/vertical"},
        "category": {"$ref": "#/$defs/category"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audience", "style"],
          "properties": {
            "audience": {"enum": ["public", "business", "internal"]},
            "style": {"enum": ["conservative", "warm", "bold"]},
            "description_sha256": {"$ref": "#/$defs/sha256",
                                   "description": "the free description is hashed, never stored here: a request's words never reach the library"}
          }
        },
        "queries": {
          "type": "array", "minItems": 3, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["tier", "language", "returned"],
            "properties": {
              "tier": {"$ref": "#/$defs/tier"},
              "language": {"enum": ["he", "en"]},
              "returned": {"type": "integer", "minimum": 0, "maximum": 60}
            }
          }
        },
        "candidates": {
          "type": "array", "maxItems": 60,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["candidate_id", "url", "tier", "source"],
            "properties": {
              "candidate_id": {"$ref": "#/$defs/id_candidate"},
              "url": {"$ref": "#/$defs/https_url"},
              "tier": {"$ref": "#/$defs/tier"},
              "source": {"enum": ["gemini_grounding", "library", "manual"]}
            }
          }
        },
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["tier1", "tier2", "tier3", "status"],
          "properties": {
            "tier1": {"type": "integer", "minimum": 0}, "tier2": {"type": "integer", "minimum": 0},
            "tier3": {"type": "integer", "minimum": 0},
            "status": {"enum": ["ok", "insufficient"]}
          }
        },
        "truncated": {"type": "integer", "minimum": 0},
        "at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"coverage": {"properties": {"status": {"const": "ok"}}}}},
         "then": {"properties": {"candidates": {"minItems": 30}}}}
      ]
    },

    "verify_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_id", "url", "http_status", "load_ms_390", "transfer_bytes", "direction", "outcome", "at"],
      "properties": {
        "kind": {"const": "verify_result"},
        "candidate_id": {"$ref": "#/$defs/id_candidate"},
        "url": {"$ref": "#/$defs/https_url"},
        "final_url": {"$ref": "#/$defs/https_url"},
        "http_status": {"type": "integer", "minimum": 0, "maximum": 599},
        "load_ms_390": {"type": ["integer", "null"], "minimum": 0, "maximum": 60000},
        "transfer_bytes": {"type": ["integer", "null"], "minimum": 0},
        "direction": {"enum": ["rtl", "neutral", "ltr_text_bound", "unknown"]},
        "robots_allowed": {"type": "boolean"},
        "outcome": {"enum": ["pass", "reject"]},
        "rejection": {"$ref": "#/$defs/rejection"},
        "at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "reject"}}}, "then": {"required": ["rejection"]}},
        {"if": {"properties": {"outcome": {"const": "pass"}}},
         "then": {"not": {"required": ["rejection"]},
                  "properties": {"http_status": {"const": 200}, "load_ms_390": {"type": "integer", "maximum": 4000},
                                 "transfer_bytes": {"type": "integer", "maximum": 6000000},
                                 "direction": {"enum": ["rtl", "neutral"]}, "robots_allowed": {"const": true}},
                  "required": ["robots_allowed"]}}
      ]
    },

    "screenshot": {
      "type": "object", "additionalProperties": false,
      "required": ["viewport_px", "full_page", "sha256", "height_px", "mime"],
      "properties": {
        "viewport_px": {"enum": [390, 1440]},
        "full_page": {"const": true},
        "sha256": {"$ref": "#/$defs/sha256"},
        "height_px": {"type": "integer", "minimum": 200, "maximum": 20000},
        "mime": {"const": "image/png"}
      }
    },

    "capture_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_id", "url", "captured_at", "outcome"],
      "properties": {
        "kind": {"const": "capture_result"},
        "candidate_id": {"$ref": "#/$defs/id_candidate"},
        "url": {"$ref": "#/$defs/https_url"},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "screenshots": {"type": "array", "items": {"$ref": "#/$defs/screenshot"}, "maxItems": 2},
        "outcome": {"enum": ["pass", "reject"]},
        "rejection": {"$ref": "#/$defs/rejection"}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "pass"}}},
         "then": {"required": ["screenshots"], "not": {"required": ["rejection"]},
                  "properties": {"screenshots": {"minItems": 2,
                                                  "allOf": [{"contains": {"properties": {"viewport_px": {"const": 390}}}},
                                                            {"contains": {"properties": {"viewport_px": {"const": 1440}}}}]}}}},
        {"if": {"properties": {"outcome": {"const": "reject"}}}, "then": {"required": ["rejection"]}}
      ]
    },

    "measured_colour": {
      "type": "object", "additionalProperties": false,
      "required": ["hex", "provenance", "confidence"],
      "properties": {
        "hex": {"$ref": "#/$defs/hex"},
        "provenance": {"enum": ["observed", "estimated"],
                       "description": "observed: read from computed styles of the captured DOM. estimated: inferred from pixels. A rule that needs a measurement never passes on an estimated value (X7)."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },

    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "source", "palette", "type", "rhythm", "imagery", "voice", "checks"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^pkt_[a-f0-9]{16}$"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["card_id", "url", "captured_at", "score_total", "approved_by"],
          "properties": {
            "card_id": {"$ref": "#/$defs/id_card"},
            "url": {"$ref": "#/$defs/https_url"},
            "captured_at": {"$ref": "#/$defs/timestamp"},
            "score_total": {"type": "integer", "minimum": 8, "maximum": 10},
            "approved_by": {"enum": ["michael", "shai"], "description": "a human approved the source card (reference-scout decision 2026-11-15)"}
          }
        },
        "palette": {
          "type": "object", "additionalProperties": false,
          "required": ["bg", "surface", "line", "text", "muted", "accent", "accent_text"],
          "properties": {
            "bg": {"$ref": "#/$defs/measured_colour"}, "surface": {"$ref": "#/$defs/measured_colour"},
            "line": {"$ref": "#/$defs/measured_colour"}, "text": {"$ref": "#/$defs/measured_colour"},
            "muted": {"$ref": "#/$defs/measured_colour"}, "accent": {"$ref": "#/$defs/measured_colour"},
            "accent_text": {"$ref": "#/$defs/measured_colour"}
          }
        },
        "type": {
          "type": "object", "additionalProperties": false,
          "required": ["heading", "body", "scale_px"],
          "properties": {
            "heading": {"$ref": "#/$defs/font"},
            "body": {"$ref": "#/$defs/font"},
            "scale_px": {"type": "array", "minItems": 3, "maxItems": 6,
                         "items": {"type": "integer", "minimum": 12, "maximum": 160}}
          }
        },
        "rhythm": {
          "type": "object", "additionalProperties": false,
          "required": ["section_gap_px", "inner_gap_px", "class"],
          "properties": {
            "section_gap_px": {"type": "integer", "minimum": 8, "maximum": 400},
            "inner_gap_px": {"type": "integer", "minimum": 4, "maximum": 200},
            "class": {"enum": ["dense", "regular", "airy"]}
          }
        },
        "imagery": {
          "type": "object", "additionalProperties": false,
          "required": ["policy", "hero_type"],
          "properties": {
            "policy": {"enum": ["photo", "illustration", "none"]},
            "hero_type": {"enum": ["full_bleed_photo", "split_photo", "illustration", "type_only", "product_grid"]}
          }
        },
        "voice": {
          "type": "object", "additionalProperties": false,
          "required": ["tone", "cta_register", "headline_pattern"],
          "properties": {
            "tone": {"enum": ["formal", "friendly"]},
            "cta_register": {"enum": ["formal", "friendly"]},
            "headline_pattern": {"enum": ["statement", "question", "name_first", "benefit_first"]}
          }
        },
        "checks": {
          "type": "object", "additionalProperties": false,
          "required": ["rules_version", "ran", "contradictions"],
          "properties": {
            "rules_version": {"const": "x-v1"},
            "ran": {"type": "array", "items": {"enum": ["X1", "X2", "X3", "X4", "X5", "X6", "X7"]},
                    "minItems": 7, "maxItems": 7, "uniqueItems": true,
                    "description": "every rule ran (a rule that did not run is not a pass)"},
            "contradictions": {"type": "array", "maxItems": 0, "description": "a packet with a contradiction is never in a set"}
          }
        }
      }
    },

    "font": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "classification", "weight", "hebrew_source"],
      "properties": {
        "family": {"type": "string", "pattern": "^[A-Za-z0-9 ]{2,40}$"},
        "classification": {"enum": ["serif", "sans", "slab", "display", "mono"]},
        "weight": {"type": "integer", "enum": [300, 400, 500, 600, 700, 800, 900]},
        "hebrew_source": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "family", "glyph_check"],
          "properties": {
            "provider": {"enum": ["google_fonts", "self_hosted_licensed"]},
            "family": {"type": "string", "pattern": "^[A-Za-z0-9 ]{2,40}$"},
            "glyph_check": {"const": "passed", "description": "the font file renders U+05D0..U+05EA; there is no system fallback (no_hebrew_font)"}
          }
        }
      }
    },

    "direction_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "vertical", "status", "at"],
      "properties": {
        "kind": {"const": "direction_set"},
        "run_id": {"$ref": "#/$defs/id_run"},
        "vertical": {"$ref": "#/$defs/vertical"},
        "status": {"enum": ["ok", "insufficient"]},
        "packets": {"type": "array", "items": {"$ref": "#/$defs/packet"}},
        "distinctness": {
          "type": "object", "additionalProperties": false,
          "required": ["metric_version", "threshold", "pairs"],
          "properties": {
            "metric_version": {"const": "d-v1"},
            "threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "provisional": {"const": true},
            "pairs": {"type": "array", "minItems": 3, "maxItems": 3,
                      "items": {"type": "object", "additionalProperties": false, "required": ["a", "b", "d"],
                                "properties": {"a": {"type": "integer", "minimum": 0, "maximum": 2},
                                               "b": {"type": "integer", "minimum": 0, "maximum": 2},
                                               "d": {"type": "number", "minimum": 0, "maximum": 1}}}}
          }
        },
        "funnel": {
          "type": "object", "additionalProperties": false,
          "required": ["candidates", "verified", "captured", "scored_8", "composed", "rejected"],
          "properties": {
            "candidates": {"type": "integer", "minimum": 0}, "verified": {"type": "integer", "minimum": 0},
            "captured": {"type": "integer", "minimum": 0}, "scored_8": {"type": "integer", "minimum": 0},
            "composed": {"type": "integer", "minimum": 0, "maximum": 3},
            "rejected": {"type": "object", "propertyNames": {"$ref": "#/$defs/reason_code"},
                         "additionalProperties": {"type": "integer", "minimum": 1}}
          }
        },
        "at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}},
         "then": {"required": ["packets", "distinctness", "funnel"],
                  "properties": {"packets": {"minItems": 3, "maxItems": 3}}}},
        {"if": {"properties": {"status": {"const": "insufficient"}}},
         "then": {"required": ["funnel"], "properties": {"packets": {"maxItems": 0}}}}
      ]
    }
  }
}
