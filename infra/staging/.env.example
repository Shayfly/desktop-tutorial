# Copy to infra/staging/.env.local. Never commit a filled-in env file.
# Values must come from dedicated Staging resources, not Preview or Production.
OMNI_ENV=staging

# Neon branch: preview-isolated-2026-10-12 (founder-reported; verify branch ancestry
# and endpoint in the Neon console before using). Keep credentials local.
OMNI_DATABASE_URL=

# Upstash database: 148ai-preview-isolated (founder-reported; verify its endpoint
# is not used by Production before using). Keep credentials local.
OMNI_REDIS_URL=

# Not yet verified/provisioned as isolated; leave empty until a separate Staging
# artifact store is confirmed. Do not point this at the shared Production bucket.
OMNI_S3_ENDPOINT=
OMNI_S3_BUCKET=
OMNI_S3_ACCESS_KEY=
OMNI_S3_SECRET_KEY=
OMNI_S3_REGION=auto
OMNI_S3_PREFIX=staging/

# Generate unique Staging-only values locally; never reuse Preview/Production keys.
OMNI_SECRET_KEY=
OMNI_SANDBOX_SHARED_SECRET=

# Fail closed until isolated service wiring and spend authorization are reviewed.
OMNI_INTAKE_MODEL=0
OMNI_INTAKE_VIA_WORKER=0
OMNI_ZERO_COST_MODE=1
OMNI_ALLOW_EXTERNAL_FALLBACK=0
OMNI_INTAKE_CALL_BUDGET_USD=0
OMNI_OPENROUTER_ENABLED=0
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
