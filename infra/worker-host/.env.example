# 148AI worker host environment. Copy the SAME values the Vercel Preview
# deployment uses; the worker and the web app must point at the same services.
# Never commit the filled-in file. On the host it lives at
# /opt/148ai/infra/worker-host/.env with mode 600.

# Identity of this environment
OMNI_ENV=staging
# Golden E2E #1 infrastructure profile (decision 2026-10-07 #27); same as Vercel Preview
OMNI_BUILD_INFRA_PROFILE=self_contained_web_v1

# Durable services (same as Vercel Preview)
OMNI_DATABASE_URL=
OMNI_REDIS_URL=
OMNI_S3_ENDPOINT=
OMNI_S3_BUCKET=omni-artifacts
OMNI_S3_ACCESS_KEY=
OMNI_S3_SECRET_KEY=
OMNI_S3_REGION=auto
OMNI_SECRET_KEY=

# Sandbox runner shared secret (64 random hex chars, generated on the host)
OMNI_SANDBOX_SHARED_SECRET=

# Model routing: external spend is allowed only inside these limits.
OMNI_ZERO_COST_MODE=0
OMNI_ALLOW_EXTERNAL_FALLBACK=1
OMNI_EXTERNAL_BUDGET_USD=0.50
OMNI_EXTERNAL_CALLS_PER_BUILD=40
OMNI_MODEL_MIN_QUALITY=70
OMNI_MODEL_CATALOG_JSON=
# Provider keys referenced by the catalog (leave empty to disable a provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image capability (optional)
REPLICATE_API_TOKEN=
