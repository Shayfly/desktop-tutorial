{
 "pr": "a2-approved-research-523",
 "sha256": [
  "tests/test_a2_approved_research.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "Accept card revision other than the rights grant.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "or grant.card_sha256 != sha or not grant.evidence_id.strip()",
     "new": "or not grant.evidence_id.strip()"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_rights_are_required_for_exact_card_revision"
   ]
  },
  {
   "id": "NC2",
   "what": "Accept prohibited Grounding origin.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "or grant.origin not in ('owned', 'independently_licensed')",
     "new": "or False"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_rights_are_required_for_exact_card_revision"
   ]
  },
  {
   "id": "NC3",
   "what": "Send the full third-party card to the model.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "'structure': copy.deepcopy(card['skeleton'])",
     "new": "'structure': copy.deepcopy(card)"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_model_receives_only_closed_structure_and_scores"
   ]
  },
  {
   "id": "NC4",
   "what": "Invent strengths without measured support.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "or any(refs[cid]['measured_scores'][k] != 2 for k in strengths)",
     "new": "or False"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_unknown_duplicate_and_unmeasured_claims_fail"
   ]
  },
  {
   "id": "NC5",
   "what": "Accept a changed evidence payload.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "if _hash(prepared['evidence']) != prepared['evidence_sha256']:",
     "new": "if False:"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_evidence_tampering_and_wrong_model_fail"
   ]
  },
  {
   "id": "NC6",
   "what": "Approve a build merely because comparison passed.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "'build_approval': False",
     "new": "'build_approval': True"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_valid_comparison_is_not_build_approval_or_measured_cost"
   ]
  },
  {
   "id": "NC7",
   "what": "Claim unknown cost is zero.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "'cost_state': 'NOT_MEASURED_HERE'",
     "new": "'cost_state': 'ZERO'"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_valid_comparison_is_not_build_approval_or_measured_cost"
   ]
  },
  {
   "id": "NC8",
   "what": "Use stale material as current.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "or row.effective_status(now) != 'fresh'",
     "new": "or False"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_retired_stale_or_unapproved_cards_are_not_admitted"
   ]
  },
  {
   "id": "NC9",
   "what": "Allow a changed model input.",
   "mutations": [
    {
     "file": "omni_prod/a2/approved_research.py",
     "old": "if _hash(model_input) != prepared['input_sha256']:",
     "new": "if False:"
    }
   ],
   "targets": [
    "tests/test_a2_approved_research.py"
   ],
   "expect_failed": [
    "test_tampered_input_and_insufficient_pool_fail"
   ]
  }
 ]
}
