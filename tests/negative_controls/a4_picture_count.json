{
 "pr": "a4-picture-count",
 "sha256": [
  "tests/test_a4_picture_count.py",
  "omni_prod/a4/__init__.py",
  "omni_prod/capability_planner.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the cap comes back: eight pictures asked are cut to three (the owner, 2026-11-26: there is no image cap)",
   "mutations": [
    {
     "file": "omni_prod/a4/__init__.py",
     "old": "max(1, asked - uploaded)",
     "new": "max(1, min(asked - uploaded, 3))"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_nothing_is_cut",
    "test_there_is_no_cap"
   ]
  },
  {
   "id": "NC2",
   "what": "the customer's own photos are not counted",
   "mutations": [
    {
     "file": "omni_prod/a4/__init__.py",
     "old": "    uploaded = len(set(_UPLOAD.findall(prompt or '')))\n",
     "new": "    uploaded = 0\n"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_never_below_one",
    "test_the_customers_photos_fill_places_first"
   ]
  },
  {
   "id": "NC3",
   "what": "the planner ignores A4: always one picture",
   "mutations": [
    {
     "file": "omni_prod/capability_planner.py",
     "old": "count = self._picture_count(IMAGE_KEY, purpose, prompt)[\"count\"] if subject else 0",
     "new": "count = 1 if subject else 0"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_nothing_is_cut",
    "test_the_number_of_pictures_is_what_a4_decided"
   ]
  },
  {
   "id": "NC4",
   "what": "the pictures go back into one requirement's quantity: one provider batch (num_outputs), which the image model bounds",
   "mutations": [
    {
     "file": "omni_prod/capability_planner.py",
     "old": "        for n in range(1, count + 1):\n",
     "new": "        for n in range(1, min(count, 1) + 1):\n"
    },
    {
     "file": "omni_prod/capability_planner.py",
     "old": "purpose=purpose, required=required, quantity=1,",
     "new": "purpose=purpose, required=required, quantity=count,"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_nothing_is_cut",
    "test_the_number_of_pictures_is_what_a4_decided"
   ]
  },
  {
   "id": "NC5",
   "what": "an icon is generated several times",
   "mutations": [
    {
     "file": "omni_prod/capability_planner.py",
     "old": "        if _kind(purpose) == \"icon\":\n            return {\"asked\": 1, \"uploaded\": 0, \"count\": 1}\n",
     "new": ""
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_an_icon_is_one"
   ]
  },
  {
   "id": "NC6",
   "what": "the brief's own text is read as the customer's count",
   "mutations": [
    {
     "file": "omni_prod/a4/__init__.py",
     "old": "    for m in _ASKED.finditer(_request_text(prompt)):",
     "new": "    for m in _ASKED.finditer(prompt or ''):"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_only_the_customers_request_is_read"
   ]
  },
  {
   "id": "NC7",
   "what": "a decimal is read as a count",
   "mutations": [
    {
     "file": "omni_prod/a4/__init__.py",
     "old": "(?<![\\w.])(\\d{1,3}|",
     "new": "(?<![\\w])(\\d{1,3}|"
    }
   ],
   "targets": [
    "tests/test_a4_picture_count.py"
   ],
   "expect_failed": [
    "test_a_number_that_is_not_a_count_of_pictures"
   ]
  }
 ]
}
