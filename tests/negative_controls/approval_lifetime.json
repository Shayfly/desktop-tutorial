{
 "pr": "caps-a-approval-lifetime",
 "sha256": ["tests/test_approval_lifetime.py", "omni_prod/brief_repository.py"],
 "controls": [
  {
   "id": "NC1",
   "what": "the old limit is back: an approval expires after 30 minutes",
   "mutations": [{"file": "omni_prod/brief_repository.py", "old": "os.getenv('OMNI_APPROVAL_TTL_MINUTES', '1440')",
                  "new": "os.getenv('OMNI_APPROVAL_TTL_MINUTES', '30')"}],
   "targets": ["tests/test_approval_lifetime.py"],
   "expect_failed": ["test_the_bound_is_a_day", "test_an_approval_of_an_unchanged_request_starts_the_build_after_23_hours",
                     "test_a_changed_request_is_refused_at_any_age", "test_a_changed_plan_or_price_is_refused_too"]
  },
  {
   "id": "NC2",
   "what": "a day-long approval no longer checks that the request is the one approved",
   "mutations": [{"file": "omni_prod/brief_repository.py",
                  "old": "        if latest is None or latest.revision != r[2] or latest.fingerprint != r[3]:",
                  "new": "        if False:"}],
   "targets": ["tests/test_approval_lifetime.py"],
   "expect_failed": ["test_a_changed_request_is_refused_at_any_age"]
  }
 ]
}
