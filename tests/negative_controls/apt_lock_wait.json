{
 "pr": "apt-lock-wait",
 "sha256": [
  "tests/test_ci_playwright_install.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "a2-offline as it was in run 44259745208: no dpkg lock wait, a stalled attempt locks out the retries",
   "mutations": [
    {
     "file": ".github/workflows/a2-offline.yml",
     "old": "          echo 'DPkg::Lock::Timeout \"150\";' | sudo tee /etc/apt/apt.conf.d/90-wait-for-dpkg-lock >/dev/null\n",
     "new": "          true  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_ci_playwright_install.py::AStalledAttemptDoesNotLockOutTheRetries"
   ],
   "expect_failed": [
    "test_apt_waits_for_the_dpkg_lock_before_the_first_attempt",
    "test_the_lock_wait_ends_inside_one_attempt"
   ]
  },
  {
   "id": "NC2",
   "what": "browser-tests in v24-ci without the dpkg lock wait",
   "mutations": [
    {
     "file": ".github/workflows/v24-ci.yml",
     "old": "          echo 'DPkg::Lock::Timeout \"150\";' | sudo tee /etc/apt/apt.conf.d/90-wait-for-dpkg-lock >/dev/null\n",
     "new": "          true  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_ci_playwright_install.py::AStalledAttemptDoesNotLockOutTheRetries"
   ],
   "expect_failed": [
    "test_apt_waits_for_the_dpkg_lock_before_the_first_attempt",
    "test_the_lock_wait_ends_inside_one_attempt"
   ]
  },
  {
   "id": "NC3",
   "what": "the lock wait outlasts one attempt: the attempt bound kills apt while it waits, and the waiter is orphaned in turn",
   "mutations": [
    {
     "file": ".github/workflows/a2-offline.yml",
     "old": "DPkg::Lock::Timeout \"150\"",
     "new": "DPkg::Lock::Timeout \"600\""
    }
   ],
   "targets": [
    "tests/test_ci_playwright_install.py::AStalledAttemptDoesNotLockOutTheRetries"
   ],
   "expect_failed": [
    "test_the_lock_wait_ends_inside_one_attempt"
   ]
  }
 ]
}
