  {"id": "NC2", "what": "a branch run counts as a drill",
   "mutations": [{"file": "tools/drill_runs_from_github.py",
                  "old": "and r.get('head_branch') == 'main'\n",
                  "new": "\n"}],
   "targets": ["tests/test_drill_runs_from_github.py"],
   "expect_failed": ["test_only_green_runs_on_main_from_schedule_or_dispatch_count"]},
