                  "new": "            got = []  # NEGATIVE CONTROL"}],
   "targets": ["tests/test_drill_runs_from_github.py"],
   "expect_failed": ["test_github_unreadable_is_exit_2_and_no_file"]},
  {"id": "NC5", "what": "an unreadable --drill-runs file is ignored by the lint",
   "mutations": [{"file": "tools/registry_lint.py",
                  "old": "            print(f'::error title=registry_lint::cannot read the drill runs from GitHub at {a.drill_runs}: {exc}')\n            return 2",
                  "new": "            github_runs = None  # NEGATIVE CONTROL"}],
   "targets": ["tests/test_drill_runs_from_github.py"],
   "expect_failed": ["test_the_lint_refuses_an_unreadable_drill_runs_file"]}
 ]
