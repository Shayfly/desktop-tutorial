                  "new": "    pass  # NEGATIVE CONTROL\n"}],
   "targets": ["tests/test_drill_runs_from_github.py"],
   "expect_failed": ["test_without_hand_records_c17_is_overdue_and_the_github_record_clears_it", "test_the_github_record_does_not_extend_past_its_last_green_run"]},
  {"id": "NC4", "what": "GitHub unreadable falls back silently to an empty record",
