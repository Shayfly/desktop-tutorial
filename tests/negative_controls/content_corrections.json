{
 "pr": "caps-a-content-corrections",
 "sha256": [
  "tests/test_content_corrections.py",
  "tests/test_site_content_agents.py",
  "omni_prod/site_content/agents.py",
  "omni_prod/site_content/validate.py",
  "omni_prod/site_content/schema.py",
  "omni_prod/routed_gateway.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the old limit is back: one correction, and then the build fails",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "MAX_CORRECTIONS = 3\n",
     "new": "MAX_CORRECTIONS = 1\n"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheBound"
   ],
   "expect_failed": [
    "test_the_bound_is_three_and_stated_in_the_evidence",
    "test_a_document_fixed_by_its_third_correction_is_built",
    "test_a_document_still_invalid_after_three_corrections_fails_loudly",
    "test_a_copy_finding_is_rewritten_until_it_passes_within_the_bound",
    "test_validation_and_copy_rounds_share_the_one_bound",
    "test_a_rewrite_that_breaks_the_document_gets_a_correction_not_a_failure"
   ]
  },
  {
   "id": "NC2",
   "what": "a correction round is logged without what it was asked to fix",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "                               'asked': [{'path': p.path, 'code': p.code} for p in block]})",
     "new": "                               'asked': []})"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheBound"
   ],
   "expect_failed": [
    "test_a_document_fixed_by_its_third_correction_is_built"
   ]
  },
  {
   "id": "NC3",
   "what": "the build evidence carries no correction rounds",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "        report.update(correction_bound=MAX_CORRECTIONS, correction_rounds=rounds)\n",
     "new": "        report.update(correction_bound=MAX_CORRECTIONS)\n"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheBound"
   ],
   "expect_failed": [
    "test_the_bound_is_three_and_stated_in_the_evidence",
    "test_a_document_fixed_by_its_third_correction_is_built",
    "test_a_document_still_invalid_after_three_corrections_fails_loudly",
    "test_a_copy_finding_is_rewritten_until_it_passes_within_the_bound",
    "test_validation_and_copy_rounds_share_the_one_bound",
    "test_a_rewrite_that_breaks_the_document_gets_a_correction_not_a_failure"
   ]
  },
  {
   "id": "NC4",
   "what": "a copy finding is rewritten past the bound: the copy rounds do not share the three corrections",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "            if len(rounds) >= MAX_CORRECTIONS:\n                report['prepass'] = found\n",
     "new": "            if False:\n                report['prepass'] = found\n"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheBound"
   ],
   "expect_failed": [
    "test_validation_and_copy_rounds_share_the_one_bound"
   ]
  },
  {
   "id": "NC5",
   "what": "review S5: the model is not told the room one answer has",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "                'output_room': {'characters': int(output_maximum(self.agent.gateway) * CHARS_PER_TOKEN_ESTIMATE),",
     "new": "                'output_room_off': {'characters': int(output_maximum(self.agent.gateway) * CHARS_PER_TOKEN_ESTIMATE),"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::AShortenedListIsSaidByName"
   ],
   "expect_failed": [
    "test_the_room_is_in_the_payload_and_the_largest_document_needs_it"
   ]
  },
  {
   "id": "NC6",
   "what": "a list the model shortened is not recorded nor said",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "        report['shortened'] = list(doc.get('shortened') or [])\n",
     "new": "        report['shortened'] = []\n"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::AShortenedListIsSaidByName"
   ],
   "expect_failed": [
    "test_a_shortened_list_is_recorded_and_said_without_a_correction"
   ]
  },
  {
   "id": "NC7",
   "what": "a shortened entry that names no offered list passes",
   "mutations": [
    {
     "file": "omni_prod/site_content/validate.py",
     "old": "                if (not isinstance(s, dict) or set(s) != {'list', 'left_out', 'why'}",
     "new": "                if False and (not isinstance(s, dict) or set(s) != {'list', 'left_out', 'why'}"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::AShortenedListIsSaidByName"
   ],
   "expect_failed": [
    "test_a_shortened_entry_that_names_no_offered_list_is_corrected"
   ]
  },
  {
   "id": "NC8",
   "what": "the owner's order 2026-11-26 16:10: a product token cap is back on the content call (8,000)",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "                         max_tokens=output_maximum(self.gateway), guard=content_shape_guard, usage=self.usage,\n                         role='content')",
     "new": "                         max_tokens=8000, guard=content_shape_guard, usage=self.usage,\n                         role='content')"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped"
   ],
   "expect_failed": [
    "test_each_call_asks_for_its_models_own_maximum",
    "test_every_call_is_measured_with_its_cost_and_the_build_totals",
    "test_a_call_that_stops_at_the_model_maximum_is_said_loudly"
   ]
  },
  {
   "id": "NC9",
   "what": "a product token cap hides in the catalogue maximum (the repository catalogue read, min 8,000)",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "    return max(int(i.get('max_output_tokens', 8192)) for i in items)",
     "new": "    return min(8000, max(int(i.get('max_output_tokens', 8192)) for i in items))"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped",
    "tests/test_content_corrections.py::AShortenedListIsSaidByName"
   ],
   "expect_failed": [
    "test_each_call_asks_for_its_models_own_maximum",
    "test_the_room_is_in_the_payload_and_the_largest_document_needs_it"
   ]
  },
  {
   "id": "NC10",
   "what": "a content call's usage is not recorded in the build evidence",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "            usage.append(_measured(gateway, start, role, max_tokens))",
     "new": "            pass"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped"
   ],
   "expect_failed": [
    "test_every_call_is_measured_with_its_cost_and_the_build_totals",
    "test_a_call_that_stops_at_the_model_maximum_is_said_loudly",
    "test_a_gateway_with_no_records_is_said_unmeasured_never_zero"
   ]
  },
  {
   "id": "NC11",
   "what": "a call that stopped on max_tokens is not said",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "        truncated = reason in _TRUNCATED or any(f'finish_reason={t}' in failure for t in _TRUNCATED)",
     "new": "        truncated = False"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped"
   ],
   "expect_failed": [
    "test_a_call_that_stops_at_the_model_maximum_is_said_loudly",
    "test_a_stop_below_the_model_maximum_is_said_as_the_budget_allowance"
   ]
  },
  {
   "id": "NC12",
   "what": "the router does not record the max_tokens it actually sent",
   "mutations": [
    {
     "file": "omni_prod/routed_gateway.py",
     "old": "            'max_tokens_sent': kwargs.get('max_tokens'), 'model_maximum': maximum}",
     "new": "            'max_tokens_sent': None, 'model_maximum': maximum}"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped"
   ],
   "expect_failed": [
    "test_every_call_is_measured_with_its_cost_and_the_build_totals"
   ]
  },
  {
   "id": "NC13",
   "what": "an unmeasured call reads as zero tokens and zero dollars",
   "mutations": [
    {
     "file": "omni_prod/site_content/agents.py",
     "old": "        if unmeasured or any(v is None for v in values):",
     "new": "        if any(v is None for v in values):"
    }
   ],
   "targets": [
    "tests/test_content_corrections.py::TheTokensAreMeasuredNotCapped"
   ],
   "expect_failed": [
    "test_a_gateway_with_no_records_is_said_unmeasured_never_zero"
   ]
  }
 ]
}
