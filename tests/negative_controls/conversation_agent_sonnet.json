     "old": "        if select not in ('cheapest', 'order'):          # a quote the worker does not understand is never guessed\n",
     "new": "        if False:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_agent_sonnet.py"
   ],
   "expect_failed": [
    "test_a_quote_the_worker_does_not_understand_is_refused"
   ]
  },
  {
   "id": "NC7",
   "what": "the rehearsal guesses a cap when the quote carries none",
   "mutations": [
    {
     "file": "omni_prod/conversation_rehearsal.py",
     "old": "    if len(found) != 1 or found[0] in (None, ''):\n",
     "new": "    if False:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_agent_sonnet.py"
   ],
   "expect_failed": [
    "test_a_cap_is_never_guessed"
   ]
  },
  {
   "id": "NC8",
   "what": "the rehearsal does not hold a conversation to its turns",
   "mutations": [
    {
     "file": "omni_prod/conversation_rehearsal.py",
     "old": "        if self.max_turns is not None and self.turns >= self.max_turns:\n",
     "new": "        if False:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_agent_sonnet.py"
   ],
   "expect_failed": [
    "test_each_conversation_is_held_to_its_turns_and_its_cap_as_typed_limits"
   ]
  },
  {
   "id": "NC9",
   "what": "a refusal before contact reaches the supervisor as \"model unavailable\", not as the limit",
   "mutations": [
    {
     "file": "omni_prod/intake/interpreter.py",
     "old": "        if isinstance(error, LimitReached):         # refused before any provider contact: the conversation's limit\n            base.limit = error.public()\n",
     "new": "        pass  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_agent_sonnet.py"
   ],
   "expect_failed": [
    "test_each_conversation_is_held_to_its_turns_and_its_cap_as_typed_limits"
   ]
  }
 ]
