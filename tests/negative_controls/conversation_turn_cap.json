{
 "pr": "conversation-turn-cap",
 "sha256": [
  "tests/test_conversation_turn_cap.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the agent's turns are reserved with no turn cap",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "            caps = dataclasses.replace(caps, project_turns=agent.MAX_TURNS)\n",
     "new": "            pass  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_the_agent_account_reserves_under_the_8_turn_cap"
   ]
  },
  {
   "id": "NC2",
   "what": "every account gets the 8-turn cap, not only the agent",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if agent.enabled():                     # the agent's turn cap (owner 2026-11-18); every other account: no cap\n",
     "new": "        if True:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_every_other_account_has_no_turn_cap"
   ]
  },
  {
   "id": "NC3",
   "what": "a cap refusal stays untyped: the customer reads \"provider busy\"",
   "mutations": [
    {
     "file": "omni_prod/intake/worker_route.py",
     "old": "        except B.TurnCapReached as exc:         # the agent's turn cap (owner 2026-11-18)\n",
     "new": "        except ZeroDivisionError as exc:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_a_cap_refusal_is_a_turns_limit_and_in_flight_is_busy",
    "test_a_usage_failure_never_fails_the_turn",
    "test_the_usage_is_stored_with_the_message_and_never_sent_to_the_browser"
   ]
  },
  {
   "id": "NC4",
   "what": "busy (a call still in flight) closes the conversation",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if kind == 'busy':\n",
     "new": "        if False:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_busy_is_not_a_closing_and_is_not_carried"
   ]
  },
  {
   "id": "NC5",
   "what": "busy is carried to the next message as if closed",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if (carried and carried.get('kind') in ('budget', 'turns', 'daily') and interp is not None\n",
     "new": "        if (carried and interp is not None  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_busy_is_not_a_closing_and_is_not_carried"
   ]
  },
  {
   "id": "NC6",
   "what": "the usage is not stored with the message",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "                                               **({'usage': usage} if usage else {})},\n",
     "new": "                                               },  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_a_usage_failure_never_fails_the_turn",
    "test_the_usage_is_stored_with_the_message_and_never_sent_to_the_browser"
   ]
  },
  {
   "id": "NC7",
   "what": "the conversation's cost is sent to the browser",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "                 if paid or (turn.interpretation or {}).get('limit') else None)\n",
     "new": "                 if paid or (turn.interpretation or {}).get('limit') else None)\n        turn.interpretation = {**(turn.interpretation or {}), 'usage': usage}  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_the_usage_is_stored_with_the_message_and_never_sent_to_the_browser"
   ]
  },
  {
   "id": "NC8",
   "what": "a usage read failure fails the turn",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        except Exception as exc:\n            logging.getLogger(__name__).error('INTAKE_CONVERSATION_USAGE_FAILED",
     "new": "        except ZeroDivisionError as exc:  # NEGATIVE CONTROL\n            logging.getLogger(__name__).error('INTAKE_CONVERSATION_USAGE_FAILED"
    }
   ],
   "targets": [
    "tests/test_conversation_turn_cap.py"
   ],
   "expect_failed": [
    "test_a_usage_failure_never_fails_the_turn"
   ]
  }
 ]
}
