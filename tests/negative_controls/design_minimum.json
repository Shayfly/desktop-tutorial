{
 "pr": "design-minimum",
 "sha256": ["tests/test_design_minimum.py", "omni_prod/skill_units/design_minimum/probe.py", "omni_prod/skill_units/gate.py"],
 "controls": [
  {"id": "NC1", "what": "the section count is not checked: a bare page passes",
   "mutations": [{"file": "omni_prod/skill_units/design_minimum/probe.py", "old": "    if sections < MIN_SECTIONS:\n", "new": "    if False:\n"}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_each_rule_alone_fails_the_page"]},
  {"id": "NC2", "what": "a page with no visual passes",
   "mutations": [{"file": "omni_prod/skill_units/design_minimum/probe.py", "old": "    if not visual:\n", "new": "    if False:\n"}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_each_rule_alone_fails_the_page"]},
  {"id": "NC3", "what": "a contact action shown once passes",
   "mutations": [{"file": "omni_prod/skill_units/design_minimum/probe.py", "old": "    if contact < 2:\n", "new": "    if contact < 1:\n"}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_each_rule_alone_fails_the_page"]},
  {"id": "NC4", "what": "a CSS background image is not counted as a visual: a real hero is called bare",
   "mutations": [{"file": "omni_prod/skill_units/design_minimum/probe.py", "old": " or re.search(r'background(?:-image)?\\s*:[^;\"]*url\\(',", "new": " or None and re.search(r'background(?:-image)?\\s*:[^;\"]*url\\(',"}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_a_css_background_image_is_a_visual"]},
  {"id": "NC5", "what": "the gate blocks from day one, without the three calibration builds",
   "mutations": [{"file": "omni_prod/skill_units/gate.py", "old": "    'PRO',       # professional minimum of a business site (skill_units/design_minimum; owner 2026-11-19)\n", "new": ""}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_the_gate_is_the_unit_and_warns_until_calibrated"]},
  {"id": "NC6", "what": "an app or a game with no contact action is judged as a business site",
   "mutations": [{"file": "omni_prod/skill_units/design_minimum/probe.py", "old": "    if not contact:\n", "new": "    if False:\n"}],
   "targets": ["tests/test_design_minimum.py"],
   "expect_failed": ["test_a_page_with_no_contact_action_is_not_judged"]}
 ]
}
