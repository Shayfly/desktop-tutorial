{
 "pr": "engine-on-owner",
 "sha256": [
  "infra/worker-host/docker-compose.yml",
  "tests/test_engine_on_for_the_owner.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the new engine is on for every account",
   "mutations": [
    {
     "file": "infra/worker-host/docker-compose.yml",
     "old": "${OMNI_SITE_LIBRARY:-accounts}",
     "new": "${OMNI_SITE_LIBRARY:-on}"
    }
   ],
   "targets": [
    "tests/test_engine_on_for_the_owner.py"
   ],
   "expect_failed": [
    "test_another_account_stays_on_the_existing_path_and_the_owner_gets_past_the_account_check",
    "test_the_routes_own_code_reads_it_that_way",
    "test_the_worker_is_deployed_with_the_flag_on_accounts_and_the_owner_listed"
   ]
  },
  {
   "id": "NC2",
   "what": "the new engine is off for the owner",
   "mutations": [
    {
     "file": "infra/worker-host/docker-compose.yml",
     "old": "${OMNI_SITE_LIBRARY:-accounts}",
     "new": "${OMNI_SITE_LIBRARY:-off}"
    }
   ],
   "targets": [
    "tests/test_engine_on_for_the_owner.py"
   ],
   "expect_failed": [
    "test_another_account_stays_on_the_existing_path_and_the_owner_gets_past_the_account_check",
    "test_the_routes_own_code_reads_it_that_way",
    "test_the_worker_is_deployed_with_the_flag_on_accounts_and_the_owner_listed"
   ]
  },
  {
   "id": "NC3",
   "what": "another account is listed beside the owner",
   "mutations": [
    {
     "file": "infra/worker-host/docker-compose.yml",
     "old": "${OMNI_SITE_LIBRARY_ACCOUNTS:-usr_GCWlMxENgr9vpwph}",
     "new": "${OMNI_SITE_LIBRARY_ACCOUNTS:-usr_GCWlMxENgr9vpwph,usr_someone_else}"
    }
   ],
   "targets": [
    "tests/test_engine_on_for_the_owner.py"
   ],
   "expect_failed": [
    "test_another_account_stays_on_the_existing_path_and_the_owner_gets_past_the_account_check",
    "test_the_routes_own_code_reads_it_that_way",
    "test_the_worker_is_deployed_with_the_flag_on_accounts_and_the_owner_listed"
   ]
  }
 ]
}
