{
 "pr": "evidence-runs",
 "sha256": [
  "tests/test_resolve_evidence_runs.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "a run whose conclusion is not success counts as green",
   "mutations": [
    {
     "file": "scripts/resolve_evidence_runs.py",
     "old": "    if run.get('conclusion') != 'success':\n        problems.append(f\"conclusion {run.get('conclusion')}\")\n",
     "new": "    pass  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_a_run_that_is_not_green_fails[None]",
    "test_a_run_that_is_not_green_fails[cancelled]",
    "test_a_run_that_is_not_green_fails[failure]",
    "test_a_run_that_is_not_green_fails[skipped]",
    "test_a_supporting_run_must_be_green_but_its_commit_is_not_compared",
    "test_the_summary_comes_first_and_names_every_failure"
   ]
  },
  {
   "id": "NC2",
   "what": "a run that has not completed counts as green",
   "mutations": [
    {
     "file": "scripts/resolve_evidence_runs.py",
     "old": "    if run.get('status') != 'completed':\n        problems.append(f\"not completed (status {run.get('status')})\")\n",
     "new": "    pass  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_a_run_in_progress_fails"
   ]
  },
  {
   "id": "NC3",
   "what": "the cited commit is not compared with the run's head_sha",
   "mutations": [
    {
     "file": "scripts/resolve_evidence_runs.py",
     "old": "        if c.commit and not head.startswith(c.commit.lower()):",
     "new": "        if False:  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_a_run_on_another_commit_fails",
    "test_every_citing_record_is_checked_against_its_commit"
   ]
  },
  {
   "id": "NC4",
   "what": "a run GitHub does not have (HTTP 404) counts as green",
   "mutations": [
    {
     "file": "scripts/resolve_evidence_runs.py",
     "old": "            return 'red', ['missing: GitHub has no such run (HTTP 404)'], {}",
     "new": "            return 'green', [], {'id': run_id}  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_a_missing_run_fails"
   ]
  },
  {
