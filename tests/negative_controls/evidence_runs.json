   "what": "a network error, a timeout or a non-JSON answer passes silently",
   "mutations": [
    {
     "file": "scripts/resolve_evidence_runs.py",
     "old": "        return 'unverified', [f'API error: {type(exc).__name__}: {exc}'], {}",
     "new": "        return 'green', [], {}  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_an_api_error_is_unverified_never_a_pass[network]",
    "test_an_api_error_is_unverified_never_a_pass[not-json]",
    "test_an_api_error_is_unverified_never_a_pass[timeout]",
    "test_the_summary_comes_first_and_names_every_failure"
   ]
  },
  {
