     "new": "        return 'green', [], {}  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_resolve_evidence_runs.py"
   ],
   "expect_failed": [
    "test_an_api_error_is_unverified_never_a_pass[http403]",
    "test_an_api_error_is_unverified_never_a_pass[http500]"
   ]
  },
  {
