   "envs": [
    "pg"
   ],
   "mutations": [
    {
     "file": "omni_prod/subscription_store.py",
     "old": "    return plan.paid_provider_budget_usd is not None and not founder_cap_exempt(user_id)",
     "new": "    return plan.paid_provider_budget_usd is not None  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_founder_cap_exempt_pg.py"
   ],
   "expect_failed": [
    "test_the_founder_builds_and_the_spend_is_still_metered",
    "test_credits_no_longer_bind_the_founder_and_are_still_counted"
   ]
  },
  {
