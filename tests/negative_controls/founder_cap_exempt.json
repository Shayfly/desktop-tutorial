     "new": "        elif plan.included_credits and used + charge > plan.included_credits:  # NEGATIVE CONTROL\n            allowed, reason = False, 'monthly credits exhausted'"
    }
   ],
   "targets": [
    "tests/test_founder_cap_exempt_pg.py"
   ],
   "expect_failed": [
    "test_credits_no_longer_bind_the_founder_and_are_still_counted"
