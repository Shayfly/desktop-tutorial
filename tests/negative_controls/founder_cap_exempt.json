     "old": "    return raw == '1' and m5_founder_account(account_id)",
     "new": "    return m5_founder_account(account_id)  # NEGATIVE CONTROL"
    },
    {
     "file": "omni_prod/pricing.py",
     "old": "    if raw not in ('0', '1'):\n        raise ValueError(",
     "new": "    if False:  # NEGATIVE CONTROL\n        raise ValueError("
    }
   ],
   "targets": [
    "tests/test_founder_cap_exempt_pg.py"
   ],
   "expect_failed": [
    "test_the_flag_turns_the_exemption_off",
    "test_an_unknown_flag_value_fails_loudly",
    "test_the_flag_turns_the_credit_exemption_off_too"
   ]
  },
  {
   "id": "NC3",
   "what": "every account is exempt: the plan budget stops nobody",
   "envs": [
    "pg"
   ],
   "mutations": [
    {
     "file": "omni_prod/subscription_store.py",
     "old": "    return plan.paid_provider_budget_usd is not None and not founder_cap_exempt(user_id)",
     "new": "    return False  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_founder_cap_exempt_pg.py"
   ],
   "expect_failed": [
    "test_the_butcher_block_is_reproduced_for_a_customer",
    "test_the_flag_turns_the_exemption_off"
   ]
  },
  {
   "id": "NC4",
   "what": "the founder is bound by credits like any customer",
