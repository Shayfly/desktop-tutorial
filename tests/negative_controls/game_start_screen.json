{
 "pr": "game-start-screen",
 "controls": [
  {
   "id": "NC1",
   "what": "browser only: the probe never presses start: a working game behind a start screen reads as frozen again",
   "mutations": [
    {
     "file": "omni_prod/game_runtime.py",
     "old": "                out[\"started_by\"] = page.evaluate(START)",
     "new": "                out[\"started_by\"] = None  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_game_runtime.py"
   ],
   "expect_failed": [
    "test_a_start_screen_is_started_the_way_a_player_starts_it"
   ],
   "envs": [
    "browser"
   ]
  },
  {
   "id": "NC2",
   "what": "browser only: any button counts as start (the probe clicks the first visible control)",
   "mutations": [
    {
     "file": "omni_prod/game_runtime.py",
     "old": "s.display !== 'none' && words.test(text)) {",
     "new": "s.display !== 'none') {"
    }
   ],
   "targets": [
    "tests/test_game_runtime.py"
   ],
   "expect_failed": [
    "test_a_control_that_is_not_start_is_not_pressed"
   ],
   "envs": [
    "browser"
   ]
  },
  {
   "id": "NC3",
   "what": "any label counts as start (the probe would press 'הוראות' or 'הגדרות')",
   "mutations": [
    {
     "file": "omni_prod/game_runtime.py",
     "old": "START_LABEL = r'^(?:התחל|התחילו|התחלה|התחל משחק|שחק|שחקו|בואו נשחק|start|start game|play|play now|begin)[!.\\s]*$'",
     "new": "START_LABEL = r'.*'"
    }
   ],
   "targets": [
    "tests/test_game_runtime_rules.py"
   ],
   "expect_failed": [
    "test_other_controls_are_not_start"
   ]
  },
  {
   "id": "NC4",
   "what": "the sandbox script carries its own copy of the pattern, not this one",
   "mutations": [
    {
     "file": "omni_prod/game_runtime.py",
     "old": "_PROBE = _PROBE.replace('#START_LABEL#', json.dumps(START_LABEL, ensure_ascii=False).replace('\\\\', '\\\\\\\\'))",
     "new": "_PROBE = _PROBE.replace('#START_LABEL#', '\"^(?:start)$\"')"
    }
   ],
   "targets": [
    "tests/test_game_runtime_rules.py"
   ],
   "expect_failed": [
    "test_the_sandbox_script_uses_this_pattern"
   ]
  }
 ]
}
