      "what": "the page refuses more than 12 images again (the owner, 2026-11-26: there is no image cap)",
      "mutations": [
        {
          "file": "omni_prod/a4/__init__.py",
          "old": "    slots.sort(key=lambda s: (PLACES.index(s['place']), s['source'] != 'upload', s['index']))\n",
          "new": "    if len(slots) > 12:\n        raise AssetPlanError(f'{len(slots)} images for one page; at most 12')\n    slots.sort(key=lambda s: (PLACES.index(s['place']), s['source'] != 'upload', s['index']))\n"
        }
      ],
      "targets": ["tests/test_a4_asset_plan.py"],
      "expect_failed": [
        "test_the_number_of_images_never_stops_the_plan"
      ]
    },
    {
      "id": "NC2",
      "what": "the image check fails a build with more than 8 images again",
      "mutations": [
        {
          "file": "omni_prod/image_match.py",
          "old": "    checked = list(images)\n    verdicts = []\n",
          "new": "    checked = list(images)\n    if len(checked) > 8:\n        raise ImageDoesNotMatch(f'{len(checked)} generated images; the image check is bounded at 8')\n    verdicts = []\n"
        }
      ],
      "targets": ["tests/test_lens11_image_match.py", "tests/test_image_per_item.py"],
      "expect_failed": [
        "test_a_wrong_picture_of_one_item_stops_the_build",
        "test_each_picture_is_made_and_judged_from_its_own_item_and_placed_next_to_it",
