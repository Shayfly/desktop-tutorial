    "test_a_model_that_makes_one_image_refuses_a_larger_quantity_before_anything_is_sent",
    "test_saved_replicate_token_selects_priced_image_provider",
    "test_replicate_official_model_submit_uses_input_only_and_resumes",
    "test_flux_1_1_pro_is_billed_per_output_and_gets_a_computed_cost"
   ]
  },
  {
   "id": "NC8",
   "what": "FLUX 1.1 pro is metered at the schnell price",
   "mutations": [
    {
     "file": "omni_prod/providers/replicate_connection.py",
     "old": "        'OMNI_IMAGE_PROVIDER_MAXIMUM_USD_PER_IMAGE': '0.04',",
     "new": "        'OMNI_IMAGE_PROVIDER_MAXIMUM_USD_PER_IMAGE': '0.003',"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py",
    "tests/test_replicate_connection.py",
    "tests/test_computed_cost_from_usage.py"
   ],
   "expect_failed": [
    "test_the_default_is_flux_1_1_pro_priced_and_licensed_from_its_profile",
    "test_every_item_picture_is_one_request_to_the_model_with_its_proportions_and_a_computed_cost",
    "test_ten_item_pictures_and_the_main_one_stay_far_under_the_build_cap",
    "test_saved_replicate_token_selects_priced_image_provider",
    "test_flux_1_1_pro_is_billed_per_output_and_gets_a_computed_cost",
    "test_a_model_that_makes_one_image_refuses_a_larger_quantity_before_anything_is_sent",
    "test_replicate_official_model_submit_uses_input_only_and_resumes"
   ]
  },
  {
   "id": "NC9",
   "what": "the owner's $0.003 connection test runs on the new $0.04 model",
   "mutations": [
    {
     "file": "omni_prod/providers/replicate_image_test.py",
     "old": "'OMNI_IMAGE_PROVIDER_MODEL': SCHNELL,",
     "new": "'OMNI_IMAGE_PROVIDER_UNUSED': SCHNELL,"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py",
    "tests/test_replicate_image_test.py"
   ],
   "expect_failed": [
    "test_the_owners_paid_connection_test_stays_on_the_cheap_model_it_confirms",
    "test_paid_submit_is_fixed_single_image_and_survives_new_process"
   ]
  },
  {
   "id": "NC10",
   "what": "the content route sends a defaulted item picture to the legacy path again (item_pictures_default) instead of placing it",
   "mutations": [
    {
     "file": "omni_prod/site_content/__init__.py",
     "old": "    asked = [(kind, words) for kind, words in beyond(Fx.customer_text(prompt)) if kind != 'picture_per_item']",
     "new": "    from ..capability_planner import item_pictures, item_pictures_wanted\n    if item_pictures_wanted(prompt) and item_pictures(prompt)['generated']:\n        return Route(LEGACY, 'item_pictures_default')\n    asked = [(kind, words) for kind, words in beyond(Fx.customer_text(prompt)) if kind != 'picture_per_item']"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_a_defaulted_item_picture_stays_on_the_library_route_which_places_it"
   ]
  }
 ]
}
