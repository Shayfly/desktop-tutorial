{
 "pr": "images-strong-default",
 "sha256": [
  "tests/test_item_pictures_default.py",
  "omni_prod/capability_planner.py",
  "omni_prod/media_pipeline.py",
  "omni_prod/providers/image_provider.py",
  "omni_prod/providers/replicate_connection.py",
  "omni_prod/providers/replicate_image_test.py",
  "omni_prod/site_content/__init__.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the picture per listed item is not the default any more: it needs the customer's words again",
   "mutations": [
    {
     "file": "omni_prod/capability_planner.py",
     "old": "    return (_CONTENT_SITE in (full_prompt or \"\") and not pictures_declined(full_prompt) and bool(_brief_items(full_prompt)))",
     "new": "    return False"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_each_listed_item_gets_a_picture_with_no_word_from_the_customer",
    "test_no_stock_photos_is_not_no_pictures",
    "test_a_defaulted_item_picture_stays_on_the_library_route_which_places_it",
    "test_every_item_picture_is_one_request_to_the_model_with_its_proportions_and_a_computed_cost",
    "test_ten_item_pictures_and_the_main_one_stay_far_under_the_build_cap"
   ]
  },
  {
   "id": "NC2",
   "what": "the customer's no-pictures is ignored by the default",
   "mutations": [
    {
     "file": "omni_prod/capability_planner.py",
     "old": " and not pictures_declined(full_prompt) and ",
     "new": " and "
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_a_customer_who_says_no_pictures_gets_none_in_three_languages",
    "test_a_defaulted_item_picture_stays_on_the_library_route_which_places_it"
   ]
  },
  {
   "id": "NC3",
   "what": "the Arabic refusal of pictures is not read",
   "mutations": [
    {
     "file": "omni_prod/media_pipeline.py",
     "old": "(?:بدون|بلا|دون|من\\s+غير|لا)",
     "new": "(?:XX)"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_a_customer_who_says_no_pictures_gets_none_in_three_languages"
   ]
  },
  {
   "id": "NC4",
   "what": "'no STOCK photos' is read as 'no pictures'",
   "mutations": [
    {
     "file": "omni_prod/media_pipeline.py",
     "old": "(?!\\s+(?:מלאי|סטוק))",
     "new": ""
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_no_stock_photos_is_not_no_pictures",
    "test_each_listed_item_gets_a_picture_with_no_word_from_the_customer",
    "test_every_item_picture_is_one_request_to_the_model_with_its_proportions_and_a_computed_cost",
    "test_ten_item_pictures_and_the_main_one_stay_far_under_the_build_cap",
    "test_a_defaulted_item_picture_stays_on_the_library_route_which_places_it"
   ]
  },
  {
   "id": "NC5",
   "what": "num_outputs is sent to a model that takes none",
   "mutations": [
    {
     "file": "omni_prod/providers/image_provider.py",
     "old": "        if not self.config.single_output:",
     "new": "        if True:"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_every_item_picture_is_one_request_to_the_model_with_its_proportions_and_a_computed_cost"
   ]
  },
  {
   "id": "NC6",
   "what": "a quantity above one for a one-image model is accepted and silently delivered short",
   "mutations": [
    {
     "file": "omni_prod/providers/image_provider.py",
     "old": "        if self.config.single_output and int(requirement.quantity) != 1:",
     "new": "        if False:"
    }
   ],
   "targets": [
    "tests/test_item_pictures_default.py"
   ],
   "expect_failed": [
    "test_a_model_that_makes_one_image_refuses_a_larger_quantity_before_anything_is_sent"
   ]
  },
  {
