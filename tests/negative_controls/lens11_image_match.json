     "new": "            continue  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_lens11_image_match.py"
   ],
   "expect_failed": [
    "test_a_check_that_cannot_run_does_not_pass"
   ]
  },
  {
