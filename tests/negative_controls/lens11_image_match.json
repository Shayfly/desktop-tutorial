     "new": "    head = bytes(data[:12])\n    if head.startswith(b'\\x89PNG\\r\\n\\x1a\\n'):\n        return 'image/jpeg'  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_lens11_image_match.py"
   ],
   "expect_failed": [
    "test_types",
    "test_both_request_dialects_carry_it"
   ]
  },
  {
