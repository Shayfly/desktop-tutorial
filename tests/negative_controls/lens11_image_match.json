    "test_eggs_for_beef_fails_before_any_code_is_written",
    "test_the_message_and_the_build_tab_line",
    "test_the_right_picture_goes_on_to_code_generation",
    "test_the_vision_model_sees_the_stored_image_and_the_customers_words"
   ]
  },
  {
