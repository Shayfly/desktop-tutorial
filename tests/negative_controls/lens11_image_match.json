     "new": "            error_code='capability_not_configured', error_message=str(exc)[:2000],  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_lens11_image_match.py"
   ],
   "expect_failed": [
    "test_a_check_that_cannot_run_does_not_pass",
