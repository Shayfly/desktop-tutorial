   "what": "a mismatch is recorded but does not stop the build",
   "mutations": [
    {
     "file": "omni_prod/image_match.py",
     "old": "        if not data['matches']:\n",
     "new": "        if False:  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_lens11_image_match.py"
   ],
   "expect_failed": [
    "test_all_turns_it_on_for_everyone_and_0_off",
