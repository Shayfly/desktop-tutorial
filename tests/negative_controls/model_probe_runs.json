   "mutations": [
    {
     "file": "omni_prod/model_probe.py",
     "old": "    return 0 if configured and all(r['result'] == 'ok' for r in configured) else 1",
     "new": "    return 0 if configured and any(r['result'] == 'ok' for r in configured) else 1"
    }
   ],
   "targets": [
    "tests/test_model_probe_runs.py"
   ],
   "expect_failed": [
