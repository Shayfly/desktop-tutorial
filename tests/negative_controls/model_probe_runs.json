    "test_the_step_ends_with_the_probes_verdict"
   ]
  },
  {
   "id": "NC2",
   "what": "the workflow step swallows the probe's exit code",
   "mutations": [
    {
     "file": ".github/workflows/model-probe.yml",
     "old": " | tail -30\n",
     "new": " | tail -30 || true  # NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_model_probe_runs.py"
   ],
   "expect_failed": [
    "test_the_step_ends_with_the_probes_verdict"
   ]
  },
  {
