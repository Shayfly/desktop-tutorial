   "what": "a refused call no longer carries the provider's own words (the record could not say why a model failed)",
   "mutations": [
    {
     "file": "omni_prod/model_probe.py",
     "old": "            row['result'] = f'error: {exc}'[:300]",
     "new": "            row['result'] = 'error'  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_model_probe_runs.py"
   ],
   "expect_failed": [
    "test_run_37814803770_is_reproduced_from_its_log_and_fails_closed",
