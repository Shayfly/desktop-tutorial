{
 "pr": "wh122-required-fields",
 "sha256": [
  "tests/test_page_requirements.py",
  "omni_prod/output_profile/required_fields.json"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "a required field gets a default: an unanswered kosher status becomes a value nobody said",
   "mutations": [
    {
     "file": "omni_prod/page_requirements.py",
     "old": "out += [Field(r.key, '', REASON + r.key, BASE,",
     "new": "out += [Field(r.key, 'standard', REASON + r.key, BASE,"
    }
   ],
   "targets": [
    "tests/test_page_requirements.py"
   ],
   "expect_failed": [
    "test_dont_know_leaves_the_field_off_with_no_default_and_it_is_not_asked_again"
   ]
  },
  {
   "id": "NC2",
   "what": "a field the agent was already given is given again: the same question twice",
   "mutations": [
    {
     "file": "omni_prod/page_requirements.py",
     "old": "        if key not in set(asked or ()):\n            return key",
     "new": "        if True:\n            return key"
    }
   ],
   "targets": [
    "tests/test_page_requirements.py"
   ],
   "expect_failed": [
    "test_a_field_the_agent_was_given_once_is_not_given_again"
   ]
  },
  {
   "id": "NC3",
   "what": "the agent asks what the customer already said: the cue and the extractors are not read",
   "mutations": [
    {
     "file": "omni_prod/page_requirements.py",
     "old": "return [r.key for r in profile.required if not stored.get(r.key) and reader(r)(customer) is None]",
     "new": "return [r.key for r in profile.required if not stored.get(r.key)]"
    }
   ],
   "targets": [
    "tests/test_page_requirements.py"
   ],
   "expect_failed": [
    "test_a_butcher_who_said_everything_is_asked_nothing",
    "test_a_butcher_who_said_only_the_phone_is_asked_for_the_rest",
    "test_a_field_the_customer_did_not_give_is_listed_as_not_given_and_never_invented",
    "test_a_field_the_message_states_is_not_asked_and_the_next_one_is",
    "test_an_event_states_its_date_place_and_registration",
    "test_kosher_or_halal_in_each_language",
    "test_no_delivery_is_an_answer_and_delivery_without_a_place_is_not",
    "test_the_customers_words_for_a_required_field_are_kept_and_bound_into_the_approved_brief",
    "test_the_route_report_names_what_the_page_did",
    "test_the_sheet_holds_the_customers_words_the_marked_defaults_and_what_is_not_given",
    "test_three_projects_are_a_list_and_two_are_not"
   ]
  },
  {
   "id": "NC4",
   "what": "a default shows on the page without its mark: the customer cannot tell it from what they said",
   "mutations": [
    {
     "file": "omni_prod/page_requirements.py",
     "old": "out.append((d.label[lang], f'{d.text[lang]} ({MARK[lang]})'))",
     "new": "out.append((d.label[lang], f'{d.text[lang]}'))"
    }
   ],
   "targets": [
    "tests/test_page_requirements.py"
   ],
   "expect_failed": [
