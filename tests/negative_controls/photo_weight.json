{
 "pr": "photo-weight",
 "sha256": [
  "tests/test_web_rendition.py",
  "omni_prod/web_rendition.py",
  "omni_prod/uploaded_assets.py",
  "requirements-production.txt",
  "omni_prod/generated_images.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the page carries the customer's 1.7 MB photo again (the butcher, bld_83529c13)",
   "mutations": [
    {
     "file": "omni_prod/uploaded_assets.py",
     "old": "        if r['changed']:\n            self.data, self.mime, self.width, self.height = r['data'], r['mime'], r['width'], r['height']\n",
     "new": ""
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_a_light_phone_photo_reaches_the_page_and_the_export_without_its_gps",
    "test_a_png_with_an_exif_chunk_and_text_is_cleaned_too",
    "test_the_page_passes_the_unit_that_failed_on_the_butcher"
   ]
  },
  {
   "id": "NC2",
   "what": "the rotation tag is dropped without turning the photo upright",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "    upright = ImageOps.exif_transpose(img)",
     "new": "    upright = img"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_a_phone_photo_stored_sideways_comes_out_upright",
    "test_it_fits_the_budget_and_the_screen",
    "test_the_similarity_passes_the_threshold_and_is_measured_again"
   ]
  },
  {
   "id": "NC7",
   "what": "the worker image does not install Pillow",
   "mutations": [
    {
     "file": "requirements-production.txt",
     "old": "Pillow==12.3.0\n",
     "new": "# Pillow removed  NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_the_worker_image_installs_the_same_pillow_the_tests_use"
   ]
  },
  {
   "id": "NC8",
   "what": "a generated image goes into the page at full weight again (the butcher's hero was generated)",
   "mutations": [
    {
     "file": "omni_prod/generated_images.py",
     "old": "        if light['changed']:\n            data, mime, width, height = light['data'], light['mime'], light['width'], light['height']\n",
     "new": ""
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_a_generated_picture_the_plan_puts_in_the_gallery_is_made_for_the_gallery",
    "test_an_icon_is_made_for_the_header",
    "test_the_real_collect_path_carries_the_light_rendition_and_keeps_the_verified_digest"
   ]
  }
 ]
}
