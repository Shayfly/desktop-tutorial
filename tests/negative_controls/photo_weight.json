{
 "pr": "photo-weight",
 "sha256": [
  "tests/test_web_rendition.py",
  "omni_prod/web_rendition.py",
  "omni_prod/uploaded_assets.py",
  "requirements-production.txt"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "the page carries the customer's 1.7 MB photo again (the butcher, bld_83529c13)",
   "mutations": [
    {
     "file": "omni_prod/uploaded_assets.py",
     "old": "        if r['changed']:\n            self.data, self.mime, self.width, self.height = r['data'], r['mime'], r['width'], r['height']\n",
     "new": ""
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_the_page_passes_the_unit_that_failed_on_the_butcher"
   ]
  },
  {
   "id": "NC2",
   "what": "the rotation tag is dropped without turning the photo upright",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "    upright = ImageOps.exif_transpose(img)",
     "new": "    upright = img"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_a_phone_photo_stored_sideways_comes_out_upright"
   ]
  },
  {
   "id": "NC3",
   "what": "a light photo is re-encoded although it needs nothing",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "    if len(data) <= BUDGET_BYTES:\n",
     "new": "    if False:\n"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_a_light_photo_is_carried_byte_for_byte"
   ]
  },
  {
   "id": "NC4",
   "what": "transparency is flattened",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "    base = upright.convert('RGBA' if has_alpha else 'RGB')",
     "new": "    base = upright.convert('RGB')"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_transparency_is_kept"
   ]
  },
  {
   "id": "NC5",
   "what": "an animated image is accepted and silently reduced to one frame",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "    if getattr(img, 'is_animated', False):",
     "new": "    if False:"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_an_animated_image_is_refused"
   ]
  },
  {
   "id": "NC6",
   "what": "the rendition is accepted over the budget",
   "mutations": [
    {
     "file": "omni_prod/web_rendition.py",
     "old": "        if out.tell() <= BUDGET_BYTES:",
     "new": "        if True:"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_it_fits_the_budget_and_the_screen",
    "test_the_page_passes_the_unit_that_failed_on_the_butcher"
   ]
  },
  {
   "id": "NC7",
   "what": "the worker image does not install Pillow",
   "mutations": [
    {
     "file": "requirements-production.txt",
     "old": "Pillow==12.3.0\n",
     "new": "# Pillow removed  NEGATIVE CONTROL\n"
    }
   ],
   "targets": [
    "tests/test_web_rendition.py"
   ],
   "expect_failed": [
    "test_the_worker_image_installs_the_same_pillow_the_tests_use"
   ]
  }
 ]
}
