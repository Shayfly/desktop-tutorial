{
  "pr": "pr162",
  "sha256": [
    "tests/test_venice_in_conversation.py"
  ],
  "controls": [
    {
      "id": "NC1",
      "what": "the worker never routes a Venice-quoted reservation to Venice",
      "mutations": [
        {
          "file": "omni_prod/intake/reservation_worker.py",
          "old": "    if (quote or {}).get('provider') == 'venice':",
          "new": "    if False:  # NEGATIVE CONTROL"
        }
      ],
      "targets": [
        "tests/test_venice_in_conversation.py"
      ],
      "expect_failed": [
        "test_missing_key_fails_when_built_so_the_reservation_is_released",
        "test_worker_executes_a_reservation_on_venice",
        "test_worker_uses_the_provider_the_reservation_was_quoted_for"
      ]
    },
    {
      "id": "NC2",
      "what": "the gateway sends Venice an empty user message instead of the customer's words",
      "mutations": [
        {
          "file": "omni_prod/providers/venice_gateway.py",
          "old": "{'role': 'user', 'content': user}",
          "new": "{'role': 'user', 'content': ''}"
        }
      ],
      "targets": [
        "tests/test_venice_in_conversation.py"
      ],
      "expect_failed": [
        "test_call_shape_private_model_no_venice_prompt_no_retries",
        "test_venice_answer_is_derived_from_the_customer_words"
      ]
    },
    {
      "id": "NC3",
      "what": "the reservation is quoted on the Gemini catalog even when Venice is selected (the hole)",
      "mutations": [
        {
          "file": "omni_prod/intake/budget.py",
          "old": "    if VG.selected():   # C3",
          "new": "    if False:   # NEGATIVE CONTROL C3"
        }
      ],
      "targets": [
        "tests/test_venice_in_conversation.py"
      ],
      "expect_failed": [
        "test_quote_is_priced_at_the_venice_ceiling_and_covers_the_call"
      ]
    }
  ]
}
