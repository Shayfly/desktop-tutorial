  },
  {
   "id": "NC6",
   "what": "a founder account passes as non-founder",
   "mutations": [
    {
     "file": "omni_prod/rehearsal.py",
     "old": "    if 'account' in report and report['account'].get('founder'):",
     "new": "    if False:"
    }
   ],
   "targets": [
    "tests/test_rehearsal_photo.py"
   ],
   "expect_failed": [
    "test_a_non_founder_run_that_turns_out_founder_fails"
   ]
  },
  {
   "id": "NC7",
   "what": "the build time budget is not installed",
   "mutations": [
    {
