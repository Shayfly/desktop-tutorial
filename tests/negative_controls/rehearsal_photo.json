   ],
   "targets": [
    "tests/test_rehearsal_photo.py"
   ],
   "expect_failed": [
    "test_base64_in_the_page_is_not_a_file"
   ]
  },
  {
   "id": "NC2",
   "what": "a dropped hero counts as kept",
   "mutations": [
    {
     "file": "omni_prod/rehearsal_photo.py",
     "old": "hero_kept = bool(hero) and all(r['placement'] == 'ok' for r in hero)",
     "new": "hero_kept = bool(hero)"
    }
   ],
   "targets": [
    "tests/test_rehearsal_photo.py"
   ],
   "expect_failed": [
    "test_a_dropped_hero_is_not_kept",
    "test_a_build_that_drops_the_hero_fails_the_rehearsal_even_if_everything_else_is_ready"
   ]
  },
  {
   "id": "NC3",
   "what": "the carried file is not checked",
