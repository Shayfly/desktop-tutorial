{
 "pr": "rehearsal-photo",
 "sha256": [
  "tests/test_rehearsal_photo.py",
  "omni_prod/rehearsal_photo.py",
  "omni_prod/rehearsal.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "base64 in the page still counts as a file",
   "mutations": [
    {
