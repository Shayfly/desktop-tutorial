     "old": "            text = wrap_ranges(text)",
     "new": "            pass  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_rtl_time_ranges.py"
   ],
   "expect_failed": [
    "test_an_rtl_request_gets_isolated_ranges_through_the_engine_transform"
   ]
  },
  {
   "id": "NC3",
   "what": "script content is not masked (JSON-LD hours get wrapped and flagged)",
   "mutations": [
    {
     "file": "omni_prod/bidi_ranges.py",
     "old": "    return _HIDDEN.sub(lambda m: ' ' * len(m.group(0)), html)",
     "new": "    return html  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_rtl_time_ranges.py"
   ],
   "expect_failed": [
    "test_the_served_page_has_its_hours_unisolated_and_is_blocked",
    "test_wrapped_it_passes_and_nothing_else_changed",
    "test_an_rtl_request_gets_isolated_ranges_through_the_engine_transform"
   ]
  },
  {
   "id": "NC4",
   "what": "any earlier dir=ltr element counts as isolating (a closed one too)",
   "mutations": [
    {
     "file": "omni_prod/bidi_ranges.py",
     "old": "    if not tags or '</' in html[tags[-1].end():start]:",
     "new": "    if not tags:  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_rtl_time_ranges.py"
   ],
   "expect_failed": [
