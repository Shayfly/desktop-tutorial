  {
   "id": "NC1",
   "what": "time ranges are not isolated: the hours read backwards on the right-to-left page",
   "mutations": [
    {
     "file": "omni_prod/section_library/__init__.py",
     "old": "    return wrap_ranges(doc), skipped\n",
     "new": "    return doc, skipped\n"
    }
   ],
   "targets": [
    "tests/test_section_library.py"
   ],
   "expect_failed": [
    "test_opening_hours_are_kept_whole_per_day",
    "test_time_ranges_keep_their_order_on_a_right_to_left_page"
   ]
  },
  {
   "id": "NC2",
   "what": "the customer's text is not escaped",
   "mutations": [
    {
     "file": "omni_prod/section_library/__init__.py",
     "old": "    return html.escape(str(s), quote=False).replace(' ₪', NBSP + '₪')\n",
     "new": "    return str(s).replace(' ₪', NBSP + '₪')\n"
    }
   ],
   "targets": [
    "tests/test_section_library.py"
   ],
   "expect_failed": [
    "test_the_customers_text_is_escaped"
   ]
  },
  {
   "id": "NC3",
   "what": "a section with no content is rendered anyway (it would be filled with invention or crash)",
   "mutations": [
    {
     "file": "omni_prod/section_library/__init__.py",
     "old": "        elif (order is None or key in order or key == 'hero') and c.get(key) and (key != 'stats' or stats_shown(c)):\n",
     "new": "        elif (order is None or key in order or key == 'hero'):\n"
    }
   ],
   "targets": [
    "tests/test_section_library.py"
   ],
   "expect_failed": [
    "test_a_number_the_hero_panel_shows_is_not_repeated_in_the_strip_and_the_drop_is_said",
    "test_a_section_with_no_content_is_skipped_and_said_never_invented",
    "test_a_team_of_three_is_not_a_row_of_three_icon_cards",
