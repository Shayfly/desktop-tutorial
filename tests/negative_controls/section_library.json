    "test_the_customers_text_is_escaped",
    "test_the_elegant_hero_carries_the_numbers_in_one_row_and_says_so",
    "test_the_first_screen_image_is_eager_and_every_other_is_lazy",
    "test_the_footer_carries_the_hours_and_whatsapp_when_given",
    "test_the_form_reaches_whatsapp_even_without_javascript_and_never_the_sites_server",
    "test_the_library_css_uses_only_the_contracts_tokens",
    "test_the_menu_toggle_is_an_icon_not_a_third_button_or_the_word_menu",
    "test_the_numbers_strip_is_the_first_tinted_beat_and_no_two_neighbours_share_a_tone",
    "test_the_owners_page_passes_the_design_contract_and_its_refusal_list",
    "test_the_page_carries_the_library_fingerprint_and_fits_the_truth_gate_window",
    "test_the_panel_facts_come_before_the_hero_photo_in_the_markup",
    "test_the_production_visual_check_finds_nothing_it_enforces_on_a_phone_or_a_desktop",
    "test_the_render_check_sees_every_element_settled_after_300ms",
    "test_the_richer_page_still_passes_the_contract_and_every_unit",
    "test_time_ranges_keep_their_order_on_a_right_to_left_page"
   ]
  },
  {
