     "file": "omni_prod/skill_units/links_tel/probe.py",
     "old": "    for d in sorted(shown - dialled):",
     "new": "    for d in []:  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_skill_gate_links.py"
   ],
   "expect_failed": [
    "test_phones"
   ]
  },
  {
   "id": "NC3",
   "what": "a broken in-page link passes",
