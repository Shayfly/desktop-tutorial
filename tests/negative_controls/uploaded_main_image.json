{
 "pr": "uploaded-main-image",
 "sha256": [
  "tests/test_uploaded_main_image.py"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "an uploaded image that is not a logo is dropped again (the production failure)",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if images and not (len(attachments) == 1",
     "new": "        if False and images and not (len(attachments) == 1"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_a_new_image_asks_its_role_again",
    "test_an_image_alone_before_any_build_is_bound_too",
    "test_change_is_said_unavailable_and_never_becomes_as_is",
    "test_kind_then_who_then_what_to_do_and_the_role_reaches_alt_and_canon",
    "test_the_production_upload_is_bound_and_asked_what_it_is_first",
    "test_the_same_bytes_twice_are_one_image",
    "test_the_whole_conversation_reaches_the_spec_with_the_photo"
   ]
  },
  {
   "id": "NC2",
   "what": "148AI may choose what an uploaded image is for the customer",
   "mutations": [
    {
     "file": "omni_prod/discovery.py",
     "old": "             delegable=False, ask_if=lambda v: bool(v.get('_image'))),",
     "new": "             delegable=True, recommended='person', ask_if=lambda v: bool(v.get('_image'))),  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_the_role_is_never_delegated_or_assumed"
   ]
  },
  {
   "id": "NC3",
   "what": "as is still generates another image",
   "mutations": [
    {
     "file": "omni_prod/discovery.py",
     "old": "    return ['media.image.generate'] if main_image(brief) else []",
     "new": "    return []  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_as_is_binds_the_photo_and_generates_nothing"
   ]
  },
  {
   "id": "NC4",
   "what": "a page without the customer's photo is accepted",
   "mutations": [
    {
     "file": "omni_prod/uploaded_assets.py",
     "old": "        if state == 'ok':\n            return report",
     "new": "        if True:  # NEGATIVE CONTROL\n            return report"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_a_page_without_the_photo_is_not_accepted"
   ]
  },
  {
   "id": "NC5",
   "what": "the reply claims the image goes with the change while it went into the request (untrue note)",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if attachments and intent != 'modify':",
     "new": "        if False:  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_the_production_upload_is_bound_and_asked_what_it_is_first"
   ]
  },
  {
   "id": "NC6",
   "what": "the photo's bytes are not checked against the approved digest",
   "mutations": [
    {
     "file": "omni_prod/uploaded_assets.py",
     "old": "        if mime not in EXT or hashlib.sha256(data).hexdigest() != digest:\n            raise ValueError('uploaded main image integrity mismatch')",
     "new": "        if mime not in EXT:  # NEGATIVE CONTROL\n            raise ValueError('uploaded main image integrity mismatch')"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_wrong_bytes_fail_loudly"
   ]
  },
  {
   "id": "NC7",
   "what": "the blind 'what to do' question is asked before the image's role is known",
   "mutations": [
    {
     "file": "omni_prod/discovery.py",
     "old": "             ask_if=lambda v: bool(v.get('_image')) and v.get('image_kind') in ('person', 'product', 'place')\n             and bool(v.get('image_identity'))),",
     "new": "             ask_if=lambda v: bool(v.get('_image'))),  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_each_kind_asks_its_own_question",
    "test_the_production_upload_is_bound_and_asked_what_it_is_first"
   ]
  },
  {
   "id": "NC8",
   "what": "the photo's alt ignores the role the customer gave",
   "mutations": [
    {
     "file": "omni_prod/uploaded_assets.py",
     "old": "    if role:\n        return role.group(1)",
     "new": "    if False:  # NEGATIVE CONTROL\n        return role.group(1)"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_kind_then_who_then_what_to_do_and_the_role_reaches_alt_and_canon"
   ]
  },
  {
   "id": "NC9",
   "what": "'change it' (not available) is silently recorded",
   "mutations": [
    {
     "file": "omni_prod/discovery.py",
     "old": "    if new.values().get('image_use') == 'change':\n        new.fields.pop('image_use', None)",
     "new": "    if False:  # NEGATIVE CONTROL\n        new.fields.pop('image_use', None)"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_change_is_said_unavailable_and_never_becomes_as_is"
   ]
  },
  {
   "id": "NC10",
   "what": "the role is not part of what the customer approves (canon)",
   "mutations": [
    {
     "file": "omni_prod/discovery.py",
     "old": "    if image:   # Michael 2026-11-15: the image's role is part of what the customer approves",
     "new": "    if False:   # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_kind_then_who_then_what_to_do_and_the_role_reaches_alt_and_canon"
   ]
  },
  {
   "id": "NC11",
   "what": "the image question waits behind the other questions (not in context)",
   "mutations": [
    {
     "file": "omni_prod/conversation/supervisor.py",
     "old": "        if image_q is not None:\n            res.asked = [image_q]",
     "new": "        if False:  # NEGATIVE CONTROL\n            res.asked = [image_q]"
    }
   ],
   "targets": [
    "tests/test_uploaded_main_image.py"
   ],
   "expect_failed": [
    "test_a_new_image_asks_its_role_again",
    "test_an_image_alone_before_any_build_is_bound_too",
    "test_change_is_said_unavailable_and_never_becomes_as_is",
    "test_kind_then_who_then_what_to_do_and_the_role_reaches_alt_and_canon",
    "test_the_production_upload_is_bound_and_asked_what_it_is_first",
    "test_the_whole_conversation_reaches_the_spec_with_the_photo"
   ]
  }
 ]
}
