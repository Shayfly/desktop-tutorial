{
 "pr": "vercel-skip-docs-previews",
 "sha256": [
  "tests/test_vercel_ignore_build.py",
  "tests/fixtures/vercel_compare_2026_11_15.json"
 ],
 "controls": [
  {
   "id": "NC1",
   "what": "a code change is judged docs-only (its preview would be skipped)",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  if (code.length) return { build: true,",
     "new": "  if (false) return { build: true,"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_a_code_change_builds_its_preview",
    "test_a_rename_out_of_docs_is_code",
    "test_previews_still_build_automatically"
   ]
  },
  {
   "id": "NC2",
   "what": "an unknown diff is skipped silently instead of building",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  if (!Array.isArray(files)) return { build: true,",
     "new": "  if (!Array.isArray(files)) return { build: false,"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_anything_unknown_builds_and_says_why"
   ]
  },
  {
   "id": "NC3",
   "what": "production ignores the release rule and falls through to the preview rules (warehouse 111: it would build every push again)",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  if (env === 'production') {\n    if (release === '1')",
     "new": "  if (false) {  // NEGATIVE CONTROL\n    if (release === '1')"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_a_pr_title_merge_with_its_number_is_a_release",
    "test_production_builds_only_a_release",
    "test_the_mark_counts_only_at_the_end_of_the_title_line"
   ]
  },
  {
   "id": "NC4",
   "what": "ci/v24-report is not on the no-preview list",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "export const NO_PREVIEW = ['ci/v24-report'];",
     "new": "export const NO_PREVIEW = [];"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_ci_v24_report_gets_no_preview_and_no_compare_call"
   ]
  },
  {
   "id": "NC5",
   "what": "only the last file decides (every -> some)",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  const code = paths.filter(p => !DOCS_ONLY.some(rx => rx.test(p)));",
     "new": "  const code = paths.slice(-1).filter(p => !DOCS_ONLY.some(rx => rx.test(p)));"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_a_rename_out_of_docs_is_code"
   ]
  },
  {
   "id": "NC6",
   "what": "the release mark counts anywhere in the commit message again (#413's accidental production release, 2026-11-16)",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  return String(message || '').split('\\n')[0].trimEnd().replace(/\\s*\\(#\\d+\\)$/, '').trimEnd().endsWith(RELEASE_MARK);",
     "new": "  return String(message || '').includes(RELEASE_MARK);  // NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_a_pr_title_merge_with_its_number_is_a_release",
    "test_the_mark_counts_only_at_the_end_of_the_title_line"
   ]
  },
  {
   "id": "NC7",
   "what": "a PR-title merge (\"... [release] (#521)\") is not a release again: 02a8dc2 canceled",
   "mutations": [
    {
     "file": "scripts/vercel_ignore_build.mjs",
     "old": "  return String(message || '').split('\\n')[0].trimEnd().replace(/\\s*\\(#\\d+\\)$/, '').trimEnd().endsWith(RELEASE_MARK);",
     "new": "  return String(message || '').split('\\n')[0].trimEnd().endsWith(RELEASE_MARK);  // NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_vercel_ignore_build.py"
   ],
   "expect_failed": [
    "test_a_pr_title_merge_with_its_number_is_a_release"
   ]
  },
  {
   "id": "NC8",
   "what": "the worker gate ignores the PR number again: the worker is not deployed on a PR-title release",
   "mutations": [
    {
     "file": "scripts/release_gate.py",
     "old": "    title = _PR_NUMBER.sub('', (message or '').split('\\n', 1)[0].rstrip())",
     "new": "    title = (message or '').split('\\n', 1)[0].rstrip()  # NEGATIVE CONTROL"
    }
   ],
   "targets": [
    "tests/test_release_gate_worker.py"
   ],
   "expect_failed": [
    "test_a_push_with_the_marker_is_deployed"
   ]
  }
 ]
}
