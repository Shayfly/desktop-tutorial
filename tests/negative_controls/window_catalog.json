                  "old": "        if by_id['age_gate'][0] > by_id['cookie_banner'][0]:",
                  "new": "        if False:  # NEGATIVE CONTROL"}],
   "targets": ["tests/test_window_catalog.py"],
   "expect_failed": ["test_cookies_before_the_age_gate_fail"]},
  {"id": "NC5", "what": "two windows open at once pass",
   "mutations": [{"file": "omni_prod/window_catalog.py",
                  "old": "    if len(open_modals) > 1:",
                  "new": "    if False:  # NEGATIVE CONTROL"}],
   "targets": ["tests/test_window_catalog.py"],
   "expect_failed": ["test_two_windows_open_at_once_fail"]},
  {"id": "NC6", "what": "an approved window is not a canon fact",
   "mutations": [{"file": "omni_prod/fact_canon.py",
                  "old": "        add('window', wid, known(wid).he)",
                  "new": "        pass  # NEGATIVE CONTROL"}],
   "targets": ["tests/test_window_catalog.py"],
   "expect_failed": ["test_an_approved_window_is_a_fact_of_the_canon"]},
  {"id": "NC7", "what": "the worker does not install the gate",
   "mutations": [{"file": "omni_prod/worker_tasks.py",
                  "old": "        install_window_gate(engine, prompt=build_prompt)\n",
                  "new": "        pass  # NEGATIVE CONTROL\n"}],
   "targets": ["tests/test_window_catalog.py"],
   "expect_failed": ["test_the_worker_installs_the_gate"]}
 ]
}
