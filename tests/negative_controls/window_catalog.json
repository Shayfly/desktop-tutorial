                  "new": "    pass  # NEGATIVE CONTROL\n"}],
   "targets": ["tests/test_window_catalog.py"],
   "expect_failed": ["test_only_the_customer_approves_a_window"]},
  {"id": "NC4", "what": "cookies before the age gate pass",
